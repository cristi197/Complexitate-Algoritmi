---
import { Menu, Search, Code2, BookOpen, FileText, ArrowUpRight } from '@lucide/astro';
import DarkModeToggle from './DarkModeToggle.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="site-header" id="site-header">
  <div class="site-header-inner">
    <button type="button" class="sidebar-toggle icon-button" id="sidebar-toggle" aria-label="Deschide meniul" aria-controls="sidebar" aria-expanded="false" title="Capitole"><Menu size={21} /></button>
    <a href={`${base}/`} class="site-logo" aria-label="InfoLiceu, acasă">
      <span class="logo-mark"><Code2 size={23} /></span>
      <span>Info<strong>Liceu</strong></span>
    </a>
    <span class="header-course">Informatică pentru BAC</span>
    <div class="header-spacer"></div>
    <div class="header-actions">
      <button type="button" class="search-trigger" id="search-trigger" onclick="openSearch(this)" aria-label="Caută capitole și instrumente" title="Caută"><Search size={18} /><span>Caută</span></button>
      <a href={`${base}/exercitii`} class="btn-header" aria-label="Exerciții" title="Exerciții"><BookOpen size={18} /><span>Exerciții</span></a>
      <a href={`${base}/subiecte-bac`} class="btn-header" aria-label="Subiecte BAC" title="Subiecte BAC"><FileText size={18} /><span>Subiecte BAC</span></a>
      <a href={`${base}/editor`} class="btn-header header-editor" aria-label="Editor C++" title="Editor C++"><Code2 size={18} /><span>Editor C++</span><ArrowUpRight size={14} /></a>
      <DarkModeToggle />
    </div>
  </div>
</header>
