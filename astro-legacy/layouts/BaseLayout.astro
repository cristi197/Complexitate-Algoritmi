---
import '../styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/manrope';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/learning.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { Search, X } from '@lucide/astro';
import { chapters } from '../data/chapters';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Ghid complet de informatică pentru liceu și bacalaureat. Algoritmi, complexitate, recursivitate, backtracking, vectori, matrici, șiruri, fișiere — cu animații interactive și quiz-uri BAC.',
  ogImage,
  bodyClass = '',
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const normalizedBase = base.replace(/\/$/, '');
const siteOrigin = (Astro.site ?? new URL('https://learnbac.ro')).toString().replace(/\/$/, '');
const siteBase   = `${siteOrigin}${base}`.replace(/\/$/, '');
const canonicalURL = `${siteOrigin}${Astro.url.pathname}`;
const ogImageURL   = ogImage || `${siteBase}/og-default.png`;
const fullTitle    = title.includes('InfoLiceu') ? title : `${title} | InfoLiceu`;
---
<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="InfoLiceu" />
  <meta property="og:title"       content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:image"       content={ogImageURL} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale"      content="ro_RO" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImageURL} />

  <!-- Misc -->
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <meta name="author" content="InfoLiceu" />
  <meta name="theme-color" content="#167568" />
  <meta name="base-url" content={base.replace(/\/$/, '')} />


  <!-- Favicon & PWA manifest -->
  <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="manifest" href={`${base}/manifest.json`} />

  <!-- Dark mode: apply before render to avoid flash -->
  <script is:inline>
    (function() {
      var stored;
      try { stored = localStorage.getItem('theme'); } catch (_) {}
      var pref   = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', stored || pref);
    })();
  </script>
</head>
<body class={bodyClass}>
  <!-- Skip navigation for keyboard/screen-reader users (WCAG 2.1 SC 2.4.1) -->
  <a class="skip-link" href="#main-content">Sari la conținut</a>

  <div id="page-overlay"></div>
  <div id="scroll-progress" aria-hidden="true"></div>

  <!-- Search Modal (Ctrl+K) -->
  <dialog id="searchModal" class="search-modal" aria-label="Caută capitol">
    <div class="search-dialog">
      <div class="search-header">
        <Search size={20} aria-hidden="true" />
        <input id="searchInput" type="search" aria-label="Caută capitole și instrumente" placeholder="Caută capitol, funcție, concept..." autocomplete="off" spellcheck="false" />
        <button type="button" class="icon-button" onclick="closeSearch()" aria-label="Închide căutarea" title="Închide căutarea"><X size={18} /></button>
      </div>
      <ul id="searchResults" aria-label="Rezultate căutare"></ul>
      <p id="search-count" class="search-footer" role="status"></p>
    </div>
  </dialog>

  <div hidden aria-hidden="true">
    {chapters.map(ch => <a data-search-entry data-search-title={ch.title} data-search-summary={ch.summary} href={`${base}/capitole/${ch.file}`}>{ch.title}</a>)}
    {[
      ['exercitii', 'Exerciții', 'Quiz-uri pe capitole și dificultate'],
      ['subiecte-bac', 'Subiecte BAC', 'Subiecte și bareme oficiale'],
      ['editor', 'Editor C++', 'Scrie și rulează cod C++'],
      ['examen-alb', 'Examen alb', 'Simulare BAC'],
      ['cheat-sheet', 'Cheat Sheet', 'Referință rapidă'],
      ['debug-live', 'Debug Live', 'Execuție pas cu pas'],
      ['analiza-bac', 'Analiză BAC', 'Analiza subiectelor'],
      ['streak', 'Calendar studiu', 'Progresul zilnic'],
    ].map(([file, title, summary]) => <a data-search-entry data-search-title={title} data-search-summary={summary} href={`${base}/${file}`}>{title}</a>)}
  </div>

  <!-- XP toast -->
  <div id="xp-toast" class="xp-toast" aria-live="polite" aria-atomic="true"></div>

  <slot />

  <script is:inline define:vars={{ normalizedBase }}>
    // Expose base URL for search.js (normalized, no trailing slash)
    window.__BASE_URL = normalizedBase;
  </script>
  <script is:inline defer src={`${base}/js/search.js`}></script>
  <script is:inline defer src={`${base}/js/progress.js`}></script>
  <script is:inline defer src={`${base}/js/analytics.js`}></script>
  <script is:inline defer src={`${base}/js/site.js`}></script>
  <script is:inline define:vars={{ normalizedBase }}>
    // Register service worker for offline caching
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        var swPath = normalizedBase + '/sw.js';
        var swScope = normalizedBase + '/';
        navigator.serviceWorker.register(swPath, { scope: swScope }).catch(function() {});
      });
    }
  </script>
</body>
</html>
