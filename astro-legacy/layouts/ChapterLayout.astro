---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { ArrowLeft, ArrowRight, Clock3, List, ChevronDown, CircleCheck, BookOpen } from '@lucide/astro';
import { chapters } from '../data/chapters';

interface Props {
  title: string;
  subtitle: string;
  icon: string;
  gradient: string;
  tags?: string[];
  sections?: { id: string; label: string }[];
  chapterNum: number;
  description?: string;
}
const { title, subtitle, tags = [], sections = [], chapterNum, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentIdx = chapters.findIndex(ch => ch.num === chapterNum);
const chapter = chapters[currentIdx];
const prevCh = chapters[currentIdx - 1];
const nextCh = chapters[currentIdx + 1];
const summary = subtitle.replace(/^Capitolul \d+\s*(?:—|&mdash;)\s*/, '');
---
<BaseLayout title={title + ' — Informatică Liceu'} description={description} bodyClass="has-sidebar chapter-page">
  <Header />
  <Sidebar activeChapter={chapterNum} />
  <div class="app-shell">
    <main class="app-content" id="main-content" tabindex="-1" data-chapter-slug={chapter.file}>
      <header class="lesson-heading">
        <nav class="lesson-breadcrumb" aria-label="Breadcrumb">
          <a href={base + '/'}>Bibliotecă</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span>
        </nav>
        <div class="lesson-kicker"><BookOpen size={15} /> Capitolul {String(chapterNum + 1).padStart(2, '0')} <span>/ 13</span></div>
        <h1>{title}</h1>
        <p class="lesson-summary">{summary}</p>
        <div class="lesson-meta">
          <span><Clock3 size={16} /><span id="reading-time">{chapter.time}</span> min de lectură</span>
          <span class="difficulty-label">{chapter.difficulty}</span>
          <span>{sections.length} secțiuni</span>
        </div>
        <div class="lesson-topics">{tags.map(tag => <span>{tag}</span>)}</div>
        <div class="lesson-actions">
          <a class="study-button" href={'#' + (sections[0]?.id ?? 'exercitii')}><BookOpen size={17} /> Începe lecția</a>
          <a class="study-button secondary" href="#exercitii"><CircleCheck size={17} /> Testează-te</a>
        </div>
      </header>
      <div class="lesson-frame">
        <aside class="lesson-outline" aria-label="Cuprins">
          <details open id="lesson-outline">
            <summary><List size={17} /><span>În acest capitol</span><ChevronDown size={16} /></summary>
            <nav class="chapter-outline" aria-label="Secțiuni capitol">
              {sections.map((section, index) => <a href={'#' + section.id}><span>{String(index + 1).padStart(2, '0')}</span>{section.label}</a>)}
            </nav>
            <div class="lesson-progress"><span>Progres lectură</span><output id="lesson-progress-text">0%</output><progress id="lesson-progress" value="0" max="100" aria-label="Progres lectură"></progress></div>
          </details>
        </aside>
        <article class="wrapper lesson-content">
          <slot />
          <nav class="chapter-nav" aria-label="Capitol anterior / următor">
            {prevCh ? <a href={base + '/capitole/' + prevCh.file} class="chapter-nav-btn prev"><ArrowLeft size={20} /><span><span class="nav-label">Capitol anterior</span><span class="nav-title">{prevCh.title}</span></span></a> : <span />}
            {nextCh ? <a href={base + '/capitole/' + nextCh.file} class="chapter-nav-btn next"><span><span class="nav-label">Capitolul următor</span><span class="nav-title">{nextCh.title}</span></span><ArrowRight size={20} /></a> : <span />}
          </nav>
        </article>
      </div>
    </main>
  </div>
  <Footer />
  <script is:inline src={base + '/js/animations.js'}></script>
  <script is:inline src={base + '/js/quiz.js'}></script>
  <script is:inline src={base + '/js/platform.js'}></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      initBarCharts();
      initTreeReveal();
      initCopyButtons();
      initSectionXP();
      initSectionReadingTime();
      initGlobalReadingTime();
      initScrollProgress();
    });
  </script>
</BaseLayout>
