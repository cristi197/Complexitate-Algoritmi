---
import ChapterLayout from '../../layouts/ChapterLayout.astro';

const sections = [{"id":"deschidere","label":"Deschidere"},{"id":"citire","label":"Citire"},{"id":"scriere","label":"Scriere"},{"id":"freopen","label":"freopen"},{"id":"prelucrare","label":"Prelucrare"},{"id":"demo","label":"Demo File I/O"},{"id":"probleme-rezolvate","label":"Probleme rezolvate"},{"id":"bac","label":"Probleme BAC"}];
---
<ChapterLayout
  title="Fișiere"
  subtitle="Capitolul 8 — ifstream, ofstream, fstream, freopen, citire/scriere, prelucrare fișiere și probleme BAC"
  icon="📁"
  gradient="linear-gradient(135deg,#831843 0%,#be185d 50%,#ec4899 100%)"
  tags={["Fișiere","fstream","ifstream","ofstream","EOF"]}
  sections={sections}
  chapterNum={8}
  description="Fișiere — informatică pentru liceu și bacalaureat"
>
<!-- ─── 1. DESCHIDERE FIȘIERE ────────────────────────── -->
<section id="deschidere">
  <div class="slide">
    <div class="slide-header">
      <span class="slide-icon icon-pink">📂</span>
      <h2>Deschiderea și închiderea fișierelor</h2>
    </div>
    <div class="slide-body">
      <div class="beginner-box">
        <div class="bb-title">📁 Analogie: Fișierele = Caiete de temă</div>
        <p>Un fișier text este ca un caiet: îl <strong>deschizi</strong> (fopen), <strong>citești</strong> sau <strong>scrii</strong> în el, apoi îl <strong>închizi</strong> (fclose). Dacă uiți să-l închizi, datele scrise pot fi pierdute!</p>
      </div>
      <p>În C++ folosim fluxuri din antetul <code>&lt;fstream></code> pentru a lucra cu fișiere text.</p>

      <pre><span class="kw">#include</span> <span class="st">&lt;fstream></span>
<span class="kw">using namespace</span> std;

<span class="cm">// ifstream — doar citire</span>
ifstream fin(<span class="st">"date.in"</span>);
<span class="kw">if</span> (!fin) &#123; cout &lt;&lt; <span class="st">"Eroare: fisierul nu exista!"</span>; <span class="kw">return</span> <span class="nu">1</span>; &#125;

<span class="cm">// ofstream — doar scriere (creează sau suprascrie fișierul)</span>
ofstream fout(<span class="st">"date.out"</span>);

<span class="cm">// ofstream cu append (adaugă la final)</span>
ofstream fapp(<span class="st">"log.txt"</span>, ios::app);

<span class="cm">// fstream — citire și scriere</span>
fstream fs(<span class="st">"date.txt"</span>, ios::in | ios::out);

<span class="cm">// Închiderea explicită (opțional — se face și automat la ieșire din funcție)</span>
fin.close();
fout.close();</pre>

      <div class="card-grid" style="grid-template-columns:1fr 1fr 1fr;margin:14px 0;">
        <div class="card pink">
          <strong>ifstream</strong>
          <p>Input File Stream — citire din fișier</p>
        </div>
        <div class="card blue">
          <strong>ofstream</strong>
          <p>Output File Stream — scriere în fișier</p>
        </div>
        <div class="card teal">
          <strong>fstream</strong>
          <p>File Stream — citire și scriere</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─── 2. CITIRE DIN FIȘIER ─────────────────────────── -->
<section id="citire">
  <div class="slide">
    <div class="slide-header">
      <span class="slide-icon icon-blue">📥</span>
      <h2>Citire din fișier</h2>
    </div>
    <div class="slide-body">
      <h3 style="margin-bottom:10px;font-size:15px;">Citire token cu token (numere, cuvinte)</h3>
      <pre>ifstream fin(<span class="st">"date.in"</span>);
<span class="kw">int</span> n, x;
fin >> n;
<span class="kw">for</span> (<span class="kw">int</span> i = <span class="nu">1</span>; i &lt;= n; i++) &#123;
    fin >> x;
    <span class="cm">// procesare x</span>
&#125;
fin.close();</pre>

      <h3 style="margin:16px 0 10px;font-size:15px;">Citire linie cu linie</h3>
      <pre>ifstream fin(<span class="st">"text.txt"</span>);
string linie;
<span class="kw">while</span> (getline(fin, linie)) &#123;
    <span class="cm">// procesare linie</span>
    cout &lt;&lt; linie &lt;&lt; endl;
&#125;</pre>

      <h3 style="margin:16px 0 10px;font-size:15px;">Citire până la EOF (fără a ști numărul de elemente)</h3>
      <pre>ifstream fin(<span class="st">"numere.in"</span>);
<span class="kw">int</span> x;
<span class="kw">while</span> (fin >> x) &#123;
    <span class="cm">// procesare x până la capătul fișierului</span>
&#125;</pre>

      <h3 style="margin:16px 0 10px;font-size:15px;">Citire matrice din fișier</h3>
      <pre>ifstream fin(<span class="st">"matrice.in"</span>);
<span class="kw">int</span> n, m, a[<span class="nu">101</span>][<span class="nu">101</span>];
fin >> n >> m;
<span class="kw">for</span> (<span class="kw">int</span> i=<span class="nu">1</span>; i&lt;=n; i++)
    <span class="kw">for</span> (<span class="kw">int</span> j=<span class="nu">1</span>; j&lt;=m; j++)
        fin >> a[i][j];</pre>
    </div>
  </div>
</section>

<!-- ─── 3. SCRIERE ───────────────────────────────────── -->
<section id="scriere">
  <div class="slide">
    <div class="slide-header">
      <span class="slide-icon icon-teal">📤</span>
      <h2>Scriere în fișier</h2>
    </div>
    <div class="slide-body">
      <pre>ofstream fout(<span class="st">"rezultat.out"</span>);

<span class="cm">// Scriere numere</span>
fout &lt;&lt; n &lt;&lt; endl;
<span class="kw">for</span> (<span class="kw">int</span> i=<span class="nu">1</span>; i&lt;=n; i++)
    fout &lt;&lt; v[i] &lt;&lt; <span class="st">" "</span>;
fout &lt;&lt; endl;

<span class="cm">// Scriere formatată — aliniere la câmpuri fixe</span>
<span class="kw">#include</span> <span class="st">&lt;iomanip></span>
fout &lt;&lt; setw(<span class="nu">10</span>) &lt;&lt; setfill(<span class="st">'0'</span>) &lt;&lt; nr;   <span class="cm">// ex: 0000000042</span>
fout &lt;&lt; fixed &lt;&lt; setprecision(<span class="nu">2</span>) &lt;&lt; <span class="nu">3.14159</span>;  <span class="cm">// 3.14</span>

fout.close();</pre>

      <div class="callout success">
        <strong>Buna practică:</strong> Apelați întotdeauna <code>fout.close()</code> sau lăsați obiectul să iasă din scope — asigurați că datele sunt scrise pe disc (flush).
      </div>
    </div>
  </div>
</section>

<!-- ─── 4. FREOPEN ───────────────────────────────────── -->
<section id="freopen">
  <div class="slide">
    <div class="slide-header">
      <span class="slide-icon icon-orange">🔀</span>
      <h2>freopen — redirectare I/O (stil BAC olimpiadă)</h2>
    </div>
    <div class="slide-body">
      <p>La olimpiadele de informatică, problemele cer citire din <code>problema.in</code> și scriere în <code>problema.out</code>. Cel mai simplu mod: <strong>redirectăm stdin/stdout</strong> cu <code>freopen</code>.</p>

      <pre><span class="kw">#include</span> <span class="st">&lt;cstdio></span>   <span class="cm">// freopen</span>
<span class="kw">#include</span> <span class="st">&lt;iostream></span>
<span class="kw">using namespace</span> std;

<span class="kw">int</span> <span class="fn">main</span>() &#123;
    freopen(<span class="st">"suma.in"</span>,  <span class="st">"r"</span>, stdin);   <span class="cm">// cin va citi din suma.in</span>
    freopen(<span class="st">"suma.out"</span>, <span class="st">"w"</span>, stdout);  <span class="cm">// cout va scrie în suma.out</span>

    <span class="kw">int</span> n, s = <span class="nu">0</span>, x;
    cin >> n;
    <span class="kw">for</span> (<span class="kw">int</span> i=<span class="nu">1</span>; i&lt;=n; i++) &#123; cin >> x; s += x; &#125;
    cout &lt;&lt; s;

    <span class="kw">return</span> <span class="nu">0</span>;
&#125;</pre>

      <div class="callout info">
        <strong>Avantaj freopen:</strong> Puteți folosi <code>cin</code>/<code>cout</code> exact ca la citirea de la tastatură. Nu trebuie să schimbați restul codului.
      </div>
      <div class="callout warning">
        <strong>Alternativă cu ifstream/ofstream:</strong> Înlocuiți <code>cin</code> cu <code>fin</code> și <code>cout</code> cu <code>fout</code>. Ambele variante sunt acceptate la BAC.
      </div>
    </div>
  </div>
</section>

<!-- ─── 5. PRELUCRARE ────────────────────────────────── -->
<section id="prelucrare">
  <div class="slide">
    <div class="slide-header">
      <span class="slide-icon icon-purple">🔧</span>
      <h2>Prelucrarea fișierelor — exemple complete</h2>
    </div>
    <div class="slide-body">
      <h3 style="margin-bottom:10px;font-size:15px;">Exemplu complet: citire din fișier, prelucrare, scriere</h3>
      <pre><span class="kw">#include</span> <span class="st">&lt;fstream></span>
<span class="kw">using namespace</span> std;

<span class="kw">int</span> <span class="fn">main</span>() &#123;
    ifstream fin(<span class="st">"maxim.in"</span>);
    ofstream fout(<span class="st">"maxim.out"</span>);

    <span class="kw">int</span> n; fin >> n;
    <span class="kw">int</span> maxim, x;
    fin >> maxim;
    <span class="kw">for</span> (<span class="kw">int</span> i=<span class="nu">2</span>; i&lt;=n; i++) &#123;
        fin >> x;
        <span class="kw">if</span> (x > maxim) maxim = x;
    &#125;
    fout &lt;&lt; maxim;

    fin.close(); fout.close();
    <span class="kw">return</span> <span class="nu">0</span>;
&#125;</pre>

      <h3 style="margin:16px 0 10px;font-size:15px;">Copiere fișier text (linie cu linie)</h3>
      <pre>ifstream fin(<span class="st">"sursa.txt"</span>);
ofstream fout(<span class="st">"copie.txt"</span>);
string linie;
<span class="kw">while</span> (getline(fin, linie))
    fout &lt;&lt; linie &lt;&lt; <span class="st">"\n"</span>;</pre>

      <h3 style="margin:16px 0 10px;font-size:15px;">Numărarea liniilor și cuvintelor dintr-un fișier</h3>
      <pre>ifstream fin(<span class="st">"text.txt"</span>);
<span class="kw">int</span> nrLinii = <span class="nu">0</span>, nrCuvinte = <span class="nu">0</span>;
string linie, cuvant;
<span class="kw">while</span> (getline(fin, linie)) &#123;
    nrLinii++;
    stringstream ss(linie);
    <span class="kw">while</span> (ss >> cuvant) nrCuvinte++;
&#125;</pre>
    </div>
  </div>
</section>
<!-- ─── 6. DEMO INTERACTIV ─────────────────────────── -->
<section id="demo">
  <div class="slide">
    <div class="slide-header">
      <span class="slide-icon icon-teal">🎮</span>
      <h2>Demo interactiv — Fluxul fișierelor</h2>
    </div>
    <div class="slide-body">
      <p>Vizualizează cum datele circulă între fișiere și program. Scenariul: <strong>date.in → program C++ → date.out</strong>.</p>

      <div id="file-demo">
        <div style="display:grid;grid-template-columns:2fr 1fr 2fr;gap:16px;margin-bottom:16px;align-items:start;">
          <!-- Input file -->
          <div style="background:var(--blue4);border:2px solid var(--blue3);border-radius:12px;padding:16px;min-height:160px;">
            <strong style="font-size:14px;">📥 date.in (Intrare)</strong>
            <div id="file-input-display" style="margin-top:10px;font-family:var(--mono);font-size:13px;background:var(--surface);border-radius:8px;padding:12px;min-height:80px;white-space:pre-line;line-height:1.5;">
              3 1 4 1 5 9 2 6
            </div>
          </div>

          <!-- Processing indicator -->
          <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding-top:40px;">
            <div style="font-size:28px;animation:pulse-arrow 1.5s ease infinite;">→</div>
            <div style="background:var(--surface2);border:2px solid var(--border);border-radius:10px;padding:12px;text-align:center;">
              <strong style="font-size:13px;">🖥️ Program C++</strong>
              <div id="file-code-display" style="font-family:var(--mono);font-size:11px;margin-top:6px;color:var(--text-muted);">while(fin >> x)<br>s += x;</div>
            </div>
            <div style="font-size:28px;animation:pulse-arrow 1.5s ease 0.75s infinite;">→</div>
          </div>

          <!-- Output file -->
          <div style="background:var(--green2);border:2px solid #bbf7d0;border-radius:12px;padding:16px;min-height:160px;">
            <strong style="font-size:14px;">📤 date.out (Ieșire)</strong>
            <div id="file-output-display" style="margin-top:10px;font-family:var(--mono);font-size:13px;background:var(--surface);border-radius:8px;padding:12px;min-height:80px;white-space:pre-line;line-height:1.5;color:var(--text-muted);">
              Aștept procesare...
            </div>
          </div>
        </div>

        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;">
          <button class="btn btn-primary" data-file="sum">➕ Citește și adună</button>
          <button class="btn btn-secondary" data-file="count">🔢 Numără elementele</button>
          <button class="btn btn-secondary" data-file="max">📈 Găsește maximul</button>
          <button class="btn btn-secondary" data-file="copy">📋 Copiază în output</button>
          <button class="btn btn-secondary" data-file="reset">↺ Reset</button>
        </div>

        <div class="speed-wrap" style="margin-bottom:10px;">
          <label>⚡ Viteză:</label>
          <input type="range" min="100" max="800" value="350" data-role="speed-slider">
          <span class="speed-label">Normal</span>
        </div>

        <!-- Processing animation -->
        <div id="file-processing" style="background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:10px 14px;min-height:36px;font-size:13px;color:var(--text-muted);"></div>
      </div>

      <div class="callout tip" style="margin-top:14px;">
        <strong>La BAC:</strong> datele sunt întotdeauna citite din fișier cu <code>ifstream</code> și scrise în fișier cu <code>ofstream</code>. Exersează <code>while (fin &gt;&gt; x)</code> — cel mai folosit idiom!
      </div>
    </div>
  </div>
</section>

<!-- ─── PROBLEME REZOLVATE ─────────────────────────── -->
  <div class="slide">
    <div class="slide-header">
      <span class="slide-icon icon-green">🧩</span>
      <h2>Probleme rezolvate — fișiere</h2>
    </div>
    <div class="slide-body">
      <p style="margin-bottom:14px;color:var(--text-muted);">5 probleme practice cu ifstream / ofstream / freopen.</p>

      <!-- Problema 1 -->
      <div class="problem-card">
        <div class="pc-header">
          <span class="pc-num">1</span>
          <span class="pc-title">Copiere fișier</span>
          <span class="pc-diff easy">Ușor</span>
        </div>
        <div class="pc-statement">Citește toate numerele din <code>date.in</code> și scrie-le în <code>date.out</code> (separate prin spațiu).</div>
        <div class="pc-io">
          <div><strong>date.in:</strong><pre>3 1 4 1 5 9 2 6</pre></div>
          <div><strong>date.out:</strong><pre>3 1 4 1 5 9 2 6</pre></div>
        </div>
        <details>
          <summary>💡 Vezi soluția</summary>
<pre>ifstream f(<span class="st">"date.in"</span>);
ofstream g(<span class="st">"date.out"</span>);
<span class="kw">int</span> x;
<span class="kw">while</span> (f >> x) g &lt;&lt; x &lt;&lt; <span class="st">' '</span>;
f.<span class="fn">close</span>(); g.<span class="fn">close</span>();</pre>
          <p style="margin-top:8px;font-size:13px;"><strong>Idiom esențial:</strong> <code>while (f &gt;&gt; x)</code> citește până la sfârșitul fișierului (EOF).</p>
        </details>
      </div>

      <!-- Problema 2 -->
      <div class="problem-card">
        <div class="pc-header">
          <span class="pc-num">2</span>
          <span class="pc-title">Suma și media numerelor din fișier</span>
          <span class="pc-diff easy">Ușor</span>
        </div>
        <div class="pc-statement">Citește din <code>numere.in</code> oricâte numere (nu știi câte). Scrie în <code>numere.out</code> suma și media (2 zecimale).</div>
        <div class="pc-io">
          <div><strong>numere.in:</strong><pre>10 20 30 40</pre></div>
          <div><strong>numere.out:</strong><pre>100 25.00</pre></div>
        </div>
        <details>
          <summary>💡 Vezi soluția</summary>
<pre>ifstream f(<span class="st">"numere.in"</span>);
ofstream g(<span class="st">"numere.out"</span>);
<span class="kw">long long</span> s = <span class="nu">0</span>; <span class="kw">int</span> n = <span class="nu">0</span>, x;
<span class="kw">while</span> (f >> x) &#123; s += x; n++; &#125;
g &lt;&lt; s &lt;&lt; <span class="st">' '</span> &lt;&lt; <span class="fn">fixed</span> &lt;&lt; <span class="fn">setprecision</span>(<span class="nu">2</span>) &lt;&lt; (<span class="kw">double</span>)s / n;</pre>
          <p style="margin-top:8px;font-size:13px;"><strong>Atenție:</strong> dacă fișierul poate fi gol (n = 0), trebuie tratat separat ca să eviți împărțirea la 0.</p>
        </details>
      </div>

      <!-- Problema 3 -->
      <div class="problem-card">
        <div class="pc-header">
          <span class="pc-num">3</span>
          <span class="pc-title">Numără cuvinte pe linie</span>
          <span class="pc-diff medium">Mediu</span>
        </div>
        <div class="pc-statement">Pentru fiecare linie din <code>text.in</code>, scrie în <code>text.out</code> numărul de cuvinte de pe acea linie.</div>
        <div class="pc-io">
          <div><strong>text.in:</strong><pre>Salut lume
Astazi e o zi frumoasa
C++</pre></div>
          <div><strong>text.out:</strong><pre>2
5
1</pre></div>
        </div>
        <details>
          <summary>💡 Vezi soluția</summary>
<pre>ifstream f(<span class="st">"text.in"</span>);
ofstream g(<span class="st">"text.out"</span>);
<span class="kw">string</span> linie, cuv;
<span class="kw">while</span> (<span class="fn">getline</span>(f, linie)) &#123;
    stringstream ss(linie);
    <span class="kw">int</span> cnt = <span class="nu">0</span>;
    <span class="kw">while</span> (ss >> cuv) cnt++;
    g &lt;&lt; cnt &lt;&lt; <span class="st">'\n'</span>;
&#125;</pre>
          <p style="margin-top:8px;font-size:13px;"><strong>Cheia:</strong> <code>getline</code> citește linia, apoi <code>stringstream</code> o sparge în cuvinte pe baza spațiilor.</p>
        </details>
      </div>

      <!-- Problema 4 -->
      <div class="problem-card">
        <div class="pc-header">
          <span class="pc-num">4</span>
          <span class="pc-title">Maxim și poziție</span>
          <span class="pc-diff medium">Mediu</span>
        </div>
        <div class="pc-statement">Citește numerele din <code>v.in</code>. Afișează în <code>v.out</code> valoarea maximă și poziția (indexată de la 1) primei apariții.</div>
        <div class="pc-io">
          <div><strong>v.in:</strong><pre>3 7 1 7 5</pre></div>
          <div><strong>v.out:</strong><pre>7 2</pre></div>
        </div>
        <details>
          <summary>💡 Vezi soluția</summary>
<pre>ifstream f(<span class="st">"v.in"</span>);
ofstream g(<span class="st">"v.out"</span>);
<span class="kw">int</span> x, idx = <span class="nu">0</span>, pos = <span class="nu">0</span>;
<span class="kw">int</span> mx = INT_MIN;
<span class="kw">while</span> (f >> x) &#123;
    idx++;
    <span class="kw">if</span> (x > mx) &#123; mx = x; pos = idx; &#125;
&#125;
g &lt;&lt; mx &lt;&lt; <span class="st">' '</span> &lt;&lt; pos;</pre>
          <p style="margin-top:8px;font-size:13px;"><strong>Detaliu:</strong> folosim <code>x &gt; mx</code> (strict) ca să reținem doar <em>prima</em> apariție a maximului.</p>
        </details>
      </div>

      <!-- Problema 5 -->
      <div class="problem-card">
        <div class="pc-header">
          <span class="pc-num">5</span>
          <span class="pc-title">Filtrare numere prime în alt fișier</span>
          <span class="pc-diff hard">Dificil</span>
        </div>
        <div class="pc-statement">Citește numere din <code>in.txt</code>. Scrie în <code>prime.txt</code> doar numerele prime, separate prin spațiu.</div>
        <div class="pc-io">
          <div><strong>in.txt:</strong><pre>10 7 4 11 9 13 1 2</pre></div>
          <div><strong>prime.txt:</strong><pre>7 11 13 2</pre></div>
        </div>
        <details>
          <summary>💡 Vezi soluția</summary>
<pre><span class="kw">bool</span> <span class="fn">prim</span>(<span class="kw">int</span> n) &#123;
    <span class="kw">if</span> (n &lt; <span class="nu">2</span>) <span class="kw">return false</span>;
    <span class="kw">for</span> (<span class="kw">int</span> d = <span class="nu">2</span>; d*d &lt;= n; d++)
        <span class="kw">if</span> (n % d == <span class="nu">0</span>) <span class="kw">return false</span>;
    <span class="kw">return true</span>;
&#125;
<span class="kw">int</span> <span class="fn">main</span>() &#123;
    ifstream f(<span class="st">"in.txt"</span>);
    ofstream g(<span class="st">"prime.txt"</span>);
    <span class="kw">int</span> x;
    <span class="kw">while</span> (f >> x)
        <span class="kw">if</span> (<span class="fn">prim</span>(x)) g &lt;&lt; x &lt;&lt; <span class="st">' '</span>;
&#125;</pre>
          <p style="margin-top:8px;font-size:13px;"><strong>Pattern frecvent:</strong> citește → filtrează cu o funcție auxiliară → scrie în fișier de ieșire.</p>
        </details>
      </div>

      <div class="callout warning" style="margin-top:16px;">
        ⚠️ <strong>La BAC:</strong> denumirea fișierelor e specificată în enunț. Citește-o cu atenție — o tipăritură greșită înseamnă 0 puncte!
      </div>
    </div>
  </div>
</section>
