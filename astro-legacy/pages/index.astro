---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { BookOpen, Search, ArrowRight, Clock3, FileText, Code2, CalendarDays } from '@lucide/astro';
import { chapters, chapterGroups } from '../data/chapters';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="InfoLiceu — Biblioteca de informatică" description="13 capitole de informatică pentru liceu și BAC, cu teorie, cod C++, demonstrații interactive și exerciții." bodyClass="has-sidebar library-page">
  <Header />
  <Sidebar />
  <div class="app-shell">
    <main class="app-content" id="main-content" tabindex="-1">
      <div class="library-content">
        <header>
          <p class="library-kicker"><BookOpen size={16} /> ÎNVAȚĂ · EXERSEAZĂ · ÎNȚELEGE</p>
          <h1 class="library-heading">Biblioteca de informatică</h1>
          <p class="library-description">Algoritmi, structuri de date și programare C++ pentru liceu și bacalaureat.</p>
          <div class="library-stats"><span><strong>13</strong> capitole</span><span><strong>C++</strong> teorie și practică</span><span><strong>BAC</strong> subiecte și exerciții</span></div>
        </header>
        <section aria-label="Capitole" id="capitole">
          <div class="library-controls">
            <div class="library-filter" role="group" aria-label="Filtrează capitolele">
              <button type="button" data-catalog-filter="all" aria-pressed="true">Toate</button>
              {chapterGroups.map(group => <button type="button" data-catalog-filter={group.id} aria-pressed="false">{group.label}</button>)}
            </div>
            <label class="catalog-search"><Search size={17} aria-hidden="true" /><span class="sr-only">Caută un capitol</span><input id="catalog-query" type="search" placeholder="Caută un capitol..." /></label>
          </div>
          <p id="catalog-count" class="library-count" role="status">13 capitole</p>
          <div class="catalog-grid" id="chapter-catalog">
            {chapters.map(chapter => (
              <a class="catalog-card" data-catalog-chapter={chapter.file} data-group={chapter.group} href={base + '/capitole/' + chapter.file}>
                <div class="catalog-card-top"><span class="catalog-icon" aria-hidden="true">{chapter.icon}</span><span class="catalog-number">{String(chapter.num + 1).padStart(2, '0')} / 13</span></div>
                <h2>{chapter.title}</h2>
                <p>{chapter.summary}</p>
                <span class="catalog-status">Vizitat</span>
                <div class="catalog-card-foot"><Clock3 size={13} /><span>{chapter.time} min</span><span>·</span><span>{chapter.difficulty}</span><ArrowRight size={17} /></div>
              </a>
            ))}
          </div>
          <p id="catalog-empty" class="library-empty" hidden>Niciun capitol găsit. Încearcă un alt termen sau schimbă categoria.</p>
        </section>
        <section class="library-resources" aria-labelledby="resources-title">
          <h2 id="resources-title">Pregătire pentru BAC</h2>
          <nav class="resource-links" aria-label="Resurse de studiu">
            <a href={base + '/exercitii'}><BookOpen size={17} /> Exerciții pe capitole</a>
            <a href={base + '/subiecte-bac'}><FileText size={17} /> Subiecte și bareme</a>
            <a href={base + '/examen-alb'}><Clock3 size={17} /> Examen alb</a>
            <a href={base + '/editor'}><Code2 size={17} /> Editor C++</a>
            <a href={base + '/streak'}><CalendarDays size={17} /> Calendar de studiu</a>
          </nav>
        </section>
      </div>
    </main>
  </div>
  <Footer />
</BaseLayout>
