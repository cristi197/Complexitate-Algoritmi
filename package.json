{
  "name": "complexitate-algoritmi",
  "version": "1.0.0",
  "description": "InfoLiceu — site Astro 6 (astro-legacy/) pentru pregătirea BAC la informatică, plus migrarea .NET (src/)",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "npm --prefix astro-legacy run dev --",
    "build": "npm --prefix astro-legacy run build",
    "preview": "npm --prefix astro-legacy run preview --",
    "css:build": "npx @tailwindcss/cli -i src/InfoLiceu.Web/wwwroot/css/app.css -o src/InfoLiceu.Web/wwwroot/css/site.css --minify",
    "css:watch": "npx @tailwindcss/cli -i src/InfoLiceu.Web/wwwroot/css/app.css -o src/InfoLiceu.Web/wwwroot/css/site.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristi197/Complexitate-Algoritmi.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cristi197/Complexitate-Algoritmi/issues"
  },
  "homepage": "https://github.com/cristi197/Complexitate-Algoritmi#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "tailwindcss": "^4.3.2"
  }
}
