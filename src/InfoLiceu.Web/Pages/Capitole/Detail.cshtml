@page "/capitole/{slug}"
@model InfoLiceu.Web.Pages.Capitole.DetailModel
@{
    ViewData["Title"] = Model.Chapter?.Title ?? "Capitol";
}

@if (Model.Chapter is null)
{
    <div class="text-center py-16">
        <h1 class="text-2xl font-bold">Capitolul nu a fost găsit</h1>
        <a href="/" class="text-[var(--color-primary)] mt-4 inline-block">← Înapoi la pagina principală</a>
    </div>
    return;
}

<!-- Chapter header -->
<section class="mb-8">
    <a href="/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition-colors no-underline">
        ← Capitole
    </a>
    <div class="flex items-center gap-4 mt-3">
        <span class="text-4xl">@Model.Chapter.Icon</span>
        <div>
            <h1 class="font-heading text-3xl font-bold">@Model.Chapter.Title</h1>
            @if (!string.IsNullOrEmpty(Model.Chapter.Subtitle))
            {
                <p class="text-[var(--color-text-muted)] mt-1">@Model.Chapter.Subtitle</p>
            }
        </div>
    </div>
</section>

<div class="flex gap-8">
    <!-- Main content area -->
    <div class="flex-1 min-w-0">
        <!-- Progress bar -->
        <div class="mb-6">
            <div class="flex justify-between text-sm text-[var(--color-text-muted)] mb-2">
                <span>Slide @(Model.CurrentIndex + 1) din @Model.TotalSlides</span>
                <span>@Math.Round((Model.CurrentIndex + 1) * 100.0 / Model.TotalSlides)%</span>
            </div>
            <div class="w-full bg-[var(--color-border)] rounded-full h-2 overflow-hidden">
                <div class="bg-[var(--color-primary)] h-full rounded-full transition-all duration-300"
                     style="width: @((Model.CurrentIndex + 1) * 100.0 / Model.TotalSlides)%"></div>
            </div>
        </div>

        <!-- Slide content (HTMX target) -->
        <div id="slide-container"
             class="bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded-xl p-6 md:p-8 min-h-[300px]">
            <partial name="_SlideContent" model="Model" />
        </div>

        <!-- Navigation buttons -->
        <div class="flex justify-between mt-6">
            @if (Model.HasPrev)
            {
                <button hx-get="/capitole/@Model.Chapter.Slug?handler=Slide&index=@(Model.CurrentIndex - 1)"
                        hx-target="#slide-container"
                        hx-swap="innerHTML show:window:top"
                        class="px-5 py-2.5 rounded-lg bg-[var(--color-bg-card)] border border-[var(--color-border)] text-sm font-medium hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] transition-colors cursor-pointer">
                    ← Anterior
                </button>
            }
            else
            {
                <div></div>
            }

            @if (Model.HasNext)
            {
                <button hx-get="/capitole/@Model.Chapter.Slug?handler=Slide&index=@(Model.CurrentIndex + 1)"
                        hx-target="#slide-container"
                        hx-swap="innerHTML show:window:top"
                        class="px-5 py-2.5 rounded-lg bg-[var(--color-primary)] text-white text-sm font-medium hover:bg-[var(--color-primary-dark)] transition-colors cursor-pointer">
                    Următorul →
                </button>
            }
            else
            {
                <div class="px-5 py-2.5 rounded-lg bg-green-600 text-white text-sm font-medium">
                    ✓ Capitol complet!
                </div>
            }
        </div>

        <!-- Quick nav dots -->
        <div class="flex justify-center gap-2 mt-6">
            @for (int i = 0; i < Model.TotalSlides; i++)
            {
                <button hx-get="/capitole/@Model.Chapter.Slug?handler=Slide&index=@i"
                        hx-target="#slide-container"
                        hx-swap="innerHTML show:window:top"
                        class="w-3 h-3 rounded-full transition-all cursor-pointer @(i == Model.CurrentIndex ? "bg-[var(--color-primary)] scale-125" : "bg-[var(--color-border)] hover:bg-[var(--color-primary)]/50")"
                        title="Slide @(i + 1)"></button>
            }
        </div>

        <!-- Keyboard shortcuts hint -->
        <p class="text-center text-xs text-[var(--color-text-muted)] mt-4">
            💡 Folosește tastele ← → pentru navigare
        </p>
    </div>

    <!-- Sidebar TOC -->
    <aside class="hidden lg:block w-56 shrink-0">
        <h3 class="font-heading text-sm font-semibold uppercase tracking-wider text-[var(--color-text-muted)] mb-4">
            Cuprins
        </h3>
        <nav class="flex flex-col gap-1" id="toc-nav">
            @for (int i = 0; i < Model.TotalSlides; i++)
            {
                <button hx-get="/capitole/@Model.Chapter.Slug?handler=Slide&index=@i"
                        hx-target="#slide-container"
                        hx-swap="innerHTML show:window:top"
                        class="text-left px-3 py-2 rounded-lg text-sm transition-colors cursor-pointer @(i == Model.CurrentIndex ? "bg-[var(--color-primary)]/10 text-[var(--color-primary)] font-semibold" : "text-[var(--color-text-muted)] hover:bg-[var(--color-bg-card)] no-underline")">
                    @Model.Slides[i].Title
                </button>
            }
        </nav>
    </aside>
</div>

@section Scripts {
    <script>
        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowLeft') {
                var prev = document.querySelector('[hx-get*="index=@(Model.CurrentIndex - 1)"]');
                if (prev && @Json.Serialize(Model.HasPrev)) prev.click();
            } else if (e.key === 'ArrowRight') {
                var next = document.querySelector('[hx-get*="index=@(Model.CurrentIndex + 1)"]');
                if (next && @Json.Serialize(Model.HasNext)) next.click();
            }
        });
    </script>
}
