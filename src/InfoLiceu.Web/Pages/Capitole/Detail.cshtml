@page "/capitole/{slug}"
@model InfoLiceu.Web.Pages.Capitole.DetailModel
@{ ViewData["Title"] = Model.Chapter?.Title ?? "Capitol"; }

@if (Model.Chapter is null)
{
    <div class="text-center py-32">
        <div class="text-6xl mb-6">🔍</div>
        <h1 class="font-heading text-3xl font-bold mb-4">Capitolul nu a fost găsit</h1>
        <a href="/" class="text-[var(--color-primary)] hover:text-[var(--color-primary-light)] no-underline transition-colors">← Înapoi la pagina principală</a>
    </div>
    return;
}

<!-- Hero -->
<div class="relative -mx-4 md:-mx-8 -mt-4 md:-mt-8 mb-12 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-900/40 via-purple-900/20 to-transparent"></div>
    <div class="relative px-4 md:px-8 py-16">
        <nav class="text-sm mb-6 opacity-60">
            <a href="/" class="text-white/60 hover:text-white no-underline transition-colors">Acasă</a>
            <span class="mx-2">›</span>
            <span class="text-white/80">@Model.Chapter.Title</span>
        </nav>
        <div class="flex items-center gap-5">
            <span class="text-5xl float" style="animation-delay:0s">@Model.Chapter.Icon</span>
            <div>
                <h1 class="font-heading text-4xl md:text-5xl font-extrabold text-white mb-3 neon-text">@Model.Chapter.Title</h1>
                @if (!string.IsNullOrEmpty(Model.Chapter.Subtitle))
                {
                    <p class="text-white/60 text-lg">@Model.Chapter.Subtitle</p>
                }
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-4 mt-6">
            @if (!string.IsNullOrEmpty(Model.Chapter.Tags))
            {
                foreach (var tag in Model.Chapter.Tags.Split(',', StringSplitOptions.TrimEntries))
                {
                    <span class="px-3 py-1.5 rounded-full bg-white/8 text-white/70 text-xs border border-white/5">@tag</span>
                }
            }
            <span class="text-white/40 text-sm">📖 ~@Model.Chapter.EstimatedMin min</span>
            <span class="text-white/40 text-sm">📄 @Model.TotalSlides slide-uri</span>
        </div>
    </div>
</div>

<div class="flex gap-8">
    <!-- TOC sidebar -->
    @if (Model.TotalSlides > 1)
    {
        <nav class="hidden lg:block w-48 shrink-0">
            <div class="sticky top-24">
                <h3 class="font-heading text-xs font-bold uppercase tracking-[0.2em] text-[var(--color-text-muted)] mb-4">Cuprins</h3>
                <div class="flex flex-col gap-1">
                    @for (int i = 0; i < Model.TotalSlides; i++)
                    {
                        <a href="javascript:void(0)" onclick="goToSlide(@i)" data-slide="@i"
                           class="toc-link block px-3 py-2.5 rounded-xl text-sm no-underline transition-all
                                  @(i == 0 ? "bg-[var(--color-primary)]/15 text-[var(--color-primary)] font-semibold border border-[var(--color-primary)]/20"
                                           : "text-[var(--color-text-muted)] hover:bg-white/5")">
                            @Model.Slides[i].Title
                        </a>
                    }
                </div>
            </div>
        </nav>
    }

    <!-- Main content -->
    <div class="flex-1 min-w-0 pb-24">
        @for (int i = 0; i < Model.TotalSlides; i++)
        {
            var slide = Model.Slides[i];
            <section class="chapter-slide @(i != 0 ? "hidden" : "")" data-slide="@i" id="slide-@i">
                <div class="glass rounded-2xl overflow-hidden mb-8 neon-border">
                    <div class="flex items-center gap-4 px-6 py-5 border-b border-[var(--color-border)] bg-white/[0.02]">
                        <span class="w-10 h-10 rounded-xl flex items-center justify-center text-lg font-bold bg-[var(--color-primary)]/15 text-[var(--color-primary)] shrink-0">
                            @(i + 1)
                        </span>
                        <h2 class="font-heading text-xl font-bold text-white m-0">@slide.Title</h2>
                    </div>
                    <div class="p-6 md:p-8">
                        @if (!string.IsNullOrEmpty(slide.Body))
                        {
                            <div class="text-[var(--color-text)] leading-relaxed">
                                @Html.Raw(Model.RenderBody(slide.Body))
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(slide.Code))
                        {
                            <div class="mt-6 rounded-xl overflow-hidden border border-[var(--color-border)]">
                                <div class="flex items-center justify-between px-4 py-2.5 bg-[#0d1117] text-xs text-gray-500">
                                    <span class="flex items-center gap-2">
                                        <span class="w-3 h-3 rounded-full bg-red-500/60"></span>
                                        <span class="w-3 h-3 rounded-full bg-yellow-500/60"></span>
                                        <span class="w-3 h-3 rounded-full bg-green-500/60"></span>
                                    </span>
                                    <span class="uppercase tracking-wider">@(slide.Language ?? "cpp")</span>
                                    <button class="hover:text-white transition-colors cursor-pointer"
                                            onclick="var c=this;navigator.clipboard.writeText(c.closest('.code-wrap').querySelector('code').textContent);c.textContent='✓';setTimeout(()=>c.textContent='📋',1500)">
                                        📋
                                    </button>
                                </div>
                                <div class="code-wrap">
                                    <pre class="p-5 m-0 overflow-x-auto text-sm leading-relaxed bg-[#0d1117] text-[#c9d1d9]"><code>@slide.Code</code></pre>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- Navigation bar -->
        @if (Model.TotalSlides > 1)
        {
            <div class="flex justify-between items-center glass rounded-2xl p-4 mt-8">
                <button id="prev-btn" onclick="goToSlide(currentSlide-1)"
                        class="px-5 py-2.5 rounded-xl bg-white/5 text-sm font-semibold hover:bg-white/10 disabled:opacity-20 disabled:cursor-not-allowed transition-all cursor-pointer">
                    ← Anterior
                </button>
                <div class="flex items-center gap-2">
                    <div class="flex gap-1.5">
                        @for (int i = 0; i < Model.TotalSlides; i++)
                        {
                            <button onclick="goToSlide(@i)"
                                    class="dot-nav w-2 h-2 rounded-full transition-all cursor-pointer @(i == 0 ? "bg-[var(--color-primary)] w-6" : "bg-white/20 hover:bg-white/40")"
                                    data-dot="@i"></button>
                        }
                    </div>
                </div>
                <button id="next-btn" onclick="goToSlide(currentSlide+1)"
                        class="px-5 py-2.5 rounded-xl bg-[var(--color-primary)] text-white text-sm font-semibold hover:bg-[var(--color-primary-dark)] disabled:opacity-20 disabled:cursor-not-allowed transition-all cursor-pointer">
                    Următorul →
                </button>
            </div>
        }

        <!-- Keyboard hint -->
        <p class="text-center text-xs text-[var(--color-text-muted)] mt-4">💡 Tastele ← → pentru navigare</p>
    </div>
</div>

@section Scripts {
    <script>
        let currentSlide = 0;
        const totalSlides = @Model.TotalSlides;

        function goToSlide(idx) {
            if (idx < 0 || idx >= totalSlides) return;
            currentSlide = idx;

            document.querySelectorAll('.chapter-slide').forEach((s,i) => s.classList.toggle('hidden', i !== idx));

            document.querySelectorAll('.toc-link').forEach((l,i) => {
                l.classList.toggle('bg-[var(--color-primary)]/15', i === idx);
                l.classList.toggle('text-[var(--color-primary)]', i === idx);
                l.classList.toggle('font-semibold', i === idx);
                l.classList.toggle('border', i === idx);
                l.classList.toggle('border-[var(--color-primary)]/20', i === idx);
            });

            document.querySelectorAll('.dot-nav').forEach((d,i) => {
                d.classList.toggle('bg-[var(--color-primary)]', i === idx);
                d.classList.toggle('w-6', i === idx);
                d.classList.toggle('bg-white/20', i !== idx);
            });

            document.getElementById('prev-btn').disabled = idx === 0;
            document.getElementById('next-btn').disabled = idx === totalSlides - 1;
            document.getElementById('slide-' + idx)?.scrollIntoView({behavior:'smooth',block:'start'});
        }

        document.addEventListener('keydown', e => {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
            if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
            if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
        });
    </script>
}


