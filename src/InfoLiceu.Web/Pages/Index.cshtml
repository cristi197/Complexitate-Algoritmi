@page
@model IndexModel
@{ ViewData["Title"] = "InfoLiceu — Platformă pentru Bacalaureat Informatică"; }

<!-- Hero -->
<section class="relative text-center py-24 px-4 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-indigo-900/20 via-transparent to-transparent pointer-events-none"></div>
    <div class="relative z-10 max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-[var(--color-border)] text-sm text-[var(--color-text-muted)] mb-8">
            <span class="w-2 h-2 rounded-full bg-[var(--color-success)] animate-pulse"></span>
            Platformă open-source pentru BAC Informatică
        </div>
        <h1 class="font-heading text-5xl md:text-7xl font-extrabold mb-6 leading-tight">
            <span class="gradient-text">Algoritmi</span>
            <br>pentru BAC
        </h1>
        <p class="text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto mb-10 leading-relaxed">
            13 capitole interactive, sute de exerciții și demo-uri vizuale —
            tot ce ai nevoie pentru pregătirea la Bacalaureatul de Informatică.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/capitole/introducere"
               class="px-8 py-4 rounded-2xl bg-[var(--color-primary)] text-white font-bold text-lg hover:bg-[var(--color-primary-dark)] transition-all hover:shadow-[0_0_30px_rgba(129,140,248,0.3)] no-underline">
                🚀 Începe să înveți
            </a>
            <a href="/exercitii"
               class="px-8 py-4 rounded-2xl glass text-[var(--color-text)] font-bold text-lg hover:border-[var(--color-primary)] transition-all no-underline">
                📝 Vezi exerciții
            </a>
        </div>
    </div>
</section>

<!-- Chapter grid -->
<section id="capitole" class="max-w-6xl mx-auto px-4 pb-24">
    <div class="text-center mb-12">
        <h2 class="font-heading text-3xl font-bold mb-3">📖 <span class="gradient-text">Capitole</span></h2>
        <p class="text-[var(--color-text-muted)]">Alege un capitol și începe să înveți</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        @foreach (var chapter in Model.Chapters)
        {
            <a href="/capitole/@chapter.Slug" class="card-3d no-underline group">
                <div class="card-3d-inner glass glass-hover p-6 rounded-2xl h-full">
                    <div class="text-4xl mb-4 float" style="animation-delay:@(Math.Abs(chapter.GetHashCode()) % 5 * 0.3)s">@chapter.Icon</div>
                    <h3 class="font-heading font-bold text-lg mb-2 text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors">
                        @chapter.Title
                    </h3>
                    @if (!string.IsNullOrEmpty(chapter.Subtitle))
                    {
                        <p class="text-sm text-[var(--color-text-muted)] mb-4">@chapter.Subtitle</p>
                    }
                    <div class="flex items-center justify-between mt-auto">
                        <span class="text-xs text-[var(--color-text-muted)]">⏱ @chapter.EstimatedMin min</span>
                        <span class="text-[var(--color-primary)] opacity-0 group-hover:opacity-100 transition-opacity text-lg">→</span>
                    </div>
                </div>
            </a>
        }
    </div>
</section>

<!-- Stats -->
<section class="max-w-6xl mx-auto px-4 pb-24">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
        <div class="glass p-6 rounded-2xl text-center">
            <div class="text-3xl font-heading font-extrabold gradient-text">13</div>
            <div class="text-sm text-[var(--color-text-muted)] mt-2">Capitole</div>
        </div>
        <div class="glass p-6 rounded-2xl text-center">
            <div class="text-3xl font-heading font-extrabold gradient-text">10+</div>
            <div class="text-sm text-[var(--color-text-muted)] mt-2">Exerciții</div>
        </div>
        <div class="glass p-6 rounded-2xl text-center">
            <div class="text-3xl font-heading font-extrabold gradient-text">35+</div>
            <div class="text-sm text-[var(--color-text-muted)] mt-2">Slide-uri</div>
        </div>
        <div class="glass p-6 rounded-2xl text-center">
            <div class="text-3xl font-heading font-extrabold gradient-text">100%</div>
            <div class="text-sm text-[var(--color-text-muted)] mt-2">Gratuit</div>
        </div>
    </div>
</section>
