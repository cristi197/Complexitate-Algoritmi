@page
@model IndexModel
@{
    ViewData["Title"] = "InfoLiceu — Platformă pentru Bacalaureat Informatică";
}

<!-- Hero -->
<section class="text-center py-16 px-4">
    <h1 class="font-heading text-4xl md:text-5xl font-extrabold mb-4">
        Învață <span class="text-[var(--color-primary)]">algoritmi</span> pentru BAC
    </h1>
    <p class="text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto mb-8">
        Platformă interactivă cu 13 capitole, sute de exerciții și demo-uri vizuale pentru pregătirea la Bacalaureatul de Informatică.
    </p>
    <a href="/capitole/introducere" 
       class="inline-block px-8 py-3 rounded-xl bg-[var(--color-primary)] text-white font-semibold text-lg hover:bg-[var(--color-primary-dark)] transition-colors">
        Începe să înveți →
    </a>
</section>

<!-- Chapter grid -->
<section class="max-w-6xl mx-auto px-4 pb-16">
    <h2 class="font-heading text-2xl font-bold mb-8">Capitole</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var chapter in Model.Chapters)
        {
            <a href="/capitole/@chapter.Slug" 
               class="block p-6 rounded-xl bg-[var(--color-bg-card)] border border-[var(--color-border)] hover:border-[var(--color-primary)] hover:shadow-md transition-all no-underline">
                <div class="text-3xl mb-3">@chapter.Icon</div>
                <h3 class="font-heading font-bold text-lg mb-1 text-[var(--color-text)]">@chapter.Title</h3>
                @if (!string.IsNullOrEmpty(chapter.Subtitle))
                {
                    <p class="text-sm text-[var(--color-text-muted)] mb-3">@chapter.Subtitle</p>
                }
                <span class="text-xs text-[var(--color-text-muted)]">⏱ @chapter.EstimatedMin min</span>
            </a>
        }
    </div>
</section>
