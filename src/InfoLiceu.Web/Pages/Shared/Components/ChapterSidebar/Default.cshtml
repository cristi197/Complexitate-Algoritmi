@model List<InfoLiceu.Domain.DTOs.ChapterCardDto>

<nav class="flex flex-col gap-0.5">
    @foreach (var chapter in Model)
    {
        <a href="/capitole/@chapter.Slug"
           class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-medium no-underline transition-all
                  text-[var(--color-text-muted)] hover:text-white hover:bg-white/5">
            <span class="text-base">@chapter.Icon</span>
            <span>@chapter.Title</span>
        </a>
    }
</nav>
