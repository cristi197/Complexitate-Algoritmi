<header class="glass sticky top-0 z-50 border-b border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto flex items-center justify-between px-4 md:px-8 h-16">
        <a href="/" class="flex items-center gap-3 no-underline group">
            <span class="text-2xl group-hover:scale-110 transition-transform">🧠</span>
            <span class="font-heading text-xl font-extrabold tracking-tight neon-text">InfoLiceu</span>
        </a>
        <nav class="hidden md:flex items-center gap-1">
            <a href="/" class="px-4 py-2 rounded-xl text-sm font-medium text-[var(--color-text-muted)] no-underline hover:text-white hover:bg-white/5 transition-all">Acasă</a>
            <a href="/#capitole" class="px-4 py-2 rounded-xl text-sm font-medium text-[var(--color-text-muted)] no-underline hover:text-white hover:bg-white/5 transition-all">Capitole</a>
            <a href="/exercitii" class="px-4 py-2 rounded-xl text-sm font-medium text-[var(--color-text-muted)] no-underline hover:text-white hover:bg-white/5 transition-all">Exerciții</a>
            <a href="/bac" class="px-4 py-2 rounded-xl text-sm font-medium text-[var(--color-text-muted)] no-underline hover:text-white hover:bg-white/5 transition-all">BAC</a>
            <button onclick="document.documentElement.classList.toggle('light-mode');localStorage.setItem('theme',document.documentElement.classList.contains('light-mode')?'light':'dark')"
                    class="ml-2 w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 hover:bg-white/10 transition-all text-lg" title="Toggle theme">🌓</button>
        </nav>
        <div class="md:hidden">
            <button onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
                    class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 hover:bg-white/10 transition-all text-lg">☰</button>
        </div>
    </div>
</header>
