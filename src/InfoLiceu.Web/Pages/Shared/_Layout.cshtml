<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — InfoLiceu</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body class="bg-[var(--color-bg)] text-[var(--color-text)] min-h-screen flex flex-col">

    <a href="#main-content" class="skip-link">Sari la conținutul principal</a>

    <partial name="_Header" />

    <div class="flex flex-1">
        <partial name="_Sidebar" />
        <main id="main-content" class="flex-1 p-4 md:p-8 max-w-5xl mx-auto w-full">
            @RenderBody()
        </main>
    </div>

    <partial name="_Footer" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
