            <line x1="65" y1="10" x2="100" y2="115" stroke="var(--purple)" stroke-width="1.5"/>
            <line x1="65" y1="10" x2="30" y2="115" stroke="var(--purple)" stroke-width="1.5"/>
            <line x1="65" y1="10" x2="10" y2="50" stroke="var(--purple)" stroke-width="1.5"/>
