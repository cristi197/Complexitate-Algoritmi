<script is:inline>
(function() {
  // ─── Interactive Graph Demo ───────────────────────────────────
  var canvas = document.getElementById('graph-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var nodes = [];
  var edges = [];
  var mode = 'node'; // 'node' or 'edge'
  var selectedNode = null;
  var animating = false;
  var animOrder = [];
  var animIdx = 0;

  var btnNode = document.getElementById('graph-mode-node');
  var btnEdge = document.getElementById('graph-mode-edge');
  var btnBFS = document.getElementById('graph-run-bfs');
  var btnDFS = document.getElementById('graph-run-dfs');
  var btnClear = document.getElementById('graph-clear');
  var btnPreset = document.getElementById('graph-preset');
  var speedSlider = document.getElementById('graph-speed');
  var startSelect = document.getElementById('graph-start');
  var traversalDelay = 520;

  function rebuildStartOptions() {
    if (!startSelect) return;
    var old = parseInt(startSelect.value || '1', 10);
    startSelect.innerHTML = '';
    for (var i = 1; i <= Math.max(1, nodes.length); i++) {
      var opt = document.createElement('option');
      opt.value = String(i);
      opt.textContent = String(i);
      startSelect.appendChild(opt);
    }
    startSelect.value = String(Math.min(Math.max(1, old), Math.max(1, nodes.length)));
  }

  function startNodeIndex() {
    if (!startSelect || nodes.length === 0) return 0;
    var v = parseInt(startSelect.value || '1', 10);
    return Math.min(nodes.length - 1, Math.max(0, v - 1));
  }

  function applySpeed() {
    if (!speedSlider) return;
    var level = parseInt(speedSlider.value || '3', 10);
    var map = { 1: 1400, 2: 900, 3: 520, 4: 300, 5: 180 };
    traversalDelay = map[level] || 520;
  }
  if (speedSlider) {
    speedSlider.addEventListener('input', applySpeed);
    applySpeed();
  }

  function setMode(m) {
    mode = m;
    selectedNode = null;
    btnNode.style.background = m === 'node' ? 'var(--primary)' : '';
    btnNode.style.color = m === 'node' ? 'white' : '';
    btnNode.style.borderColor = m === 'node' ? 'var(--primary)' : '';
    btnEdge.style.background = m === 'edge' ? 'var(--primary)' : '';
    btnEdge.style.color = m === 'edge' ? 'white' : '';
    btnEdge.style.borderColor = m === 'edge' ? 'var(--primary)' : '';
    draw();
  }

  btnNode.addEventListener('click', function() { setMode('node'); });
  btnEdge.addEventListener('click', function() { setMode('edge'); });
  btnClear.addEventListener('click', function() {
    nodes = []; edges = []; selectedNode = null; animating = false; animOrder = [];
    rebuildStartOptions(); updateStats(); draw();
  });

  btnPreset.addEventListener('click', function() {
    if (animating) return;
    nodes = [
      { x: 120, y: 85, color: null },
      { x: 250, y: 55, color: null },
      { x: 380, y: 95, color: null },
      { x: 180, y: 210, color: null },
      { x: 320, y: 225, color: null },
      { x: 510, y: 165, color: null }
    ];
    edges = [[0,1],[1,2],[0,3],[3,4],[4,2],[2,5]];
    selectedNode = null;
    rebuildStartOptions();
    updateStats(); draw();
  });

  function getCanvasCoords(e) {
    var rect = canvas.getBoundingClientRect();
    var scaleX = canvas.width / rect.width;
    var scaleY = canvas.height / rect.height;
    return { x: (e.clientX - rect.left) * scaleX, y: (e.clientY - rect.top) * scaleY };
  }

  function findNode(x, y) {
    for (var i = 0; i < nodes.length; i++) {
      var dx = nodes[i].x - x, dy = nodes[i].y - y;
      if (dx*dx + dy*dy < 400) return i;
    }
    return -1;
  }

  canvas.addEventListener('click', function(e) {
    if (animating) return;
    var pos = getCanvasCoords(e);
    if (mode === 'node') {
      if (findNode(pos.x, pos.y) === -1) {
        nodes.push({ x: pos.x, y: pos.y, color: null });
        rebuildStartOptions(); updateStats(); draw();
      }
    } else if (mode === 'edge') {
      var idx = findNode(pos.x, pos.y);
      if (idx === -1) return;
      if (selectedNode === null) {
        selectedNode = idx;
        draw();
      } else {
        if (selectedNode !== idx) {
          var exists = edges.some(function(e) {
            return (e[0]===selectedNode && e[1]===idx) || (e[0]===idx && e[1]===selectedNode);
          });
          if (!exists) {
            edges.push([selectedNode, idx]);
          }
        }
        selectedNode = null;
        updateStats(); draw();
      }
    }
  });

  function getAdj() {
    var adj = [];
    for (var i = 0; i < nodes.length; i++) adj.push([]);
    for (var i = 0; i < edges.length; i++) {
      adj[edges[i][0]].push(edges[i][1]);
      adj[edges[i][1]].push(edges[i][0]);
    }
    return adj;
  }

  function countComponents() {
    var visited = new Array(nodes.length).fill(false);
    var count = 0;
    var adj = getAdj();
    for (var i = 0; i < nodes.length; i++) {
      if (!visited[i]) {
        count++;
        var stack = [i];
        while (stack.length) {
          var n = stack.pop();
          if (visited[n]) continue;
          visited[n] = true;
          for (var j = 0; j < adj[n].length; j++) {
            if (!visited[adj[n][j]]) stack.push(adj[n][j]);
          }
        }
      }
    }
    return count;
  }

  function isEulerian() {
    if (nodes.length < 3) return false;
    if (countComponents() > 1) return false;
    var adj = getAdj();
    for (var i = 0; i < nodes.length; i++) {
      if (adj[i].length % 2 !== 0) return false;
      if (adj[i].length === 0) return false;
    }
    return true;
  }

  function updateStats() {
    var n = nodes.length, m = edges.length;
    document.getElementById('gs-nodes').textContent = n;
    document.getElementById('gs-edges').textContent = m;
    var sumDeg = 2 * m;
    document.getElementById('gs-sum-deg').textContent = sumDeg;
    document.getElementById('gs-comp').textContent = n > 0 ? countComponents() : 0;
    document.getElementById('gs-max-edges').textContent = n > 1 ? (n*(n-1)/2) : 0;
    var eulerEl = document.getElementById('gs-euler');
    eulerEl.style.display = isEulerian() ? 'inline' : 'none';
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    // Draw edges
    for (var i = 0; i < edges.length; i++) {
      var a = nodes[edges[i][0]], b = nodes[edges[i][1]];
      ctx.beginPath();
      ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y);
      ctx.strokeStyle = '#6366f1'; ctx.lineWidth = 2; ctx.globalAlpha = 0.5;
      ctx.stroke(); ctx.globalAlpha = 1;
    }
    // Draw nodes
    for (var i = 0; i < nodes.length; i++) {
      var nd = nodes[i];
      ctx.beginPath();
      ctx.arc(nd.x, nd.y, 18, 0, Math.PI * 2);
      if (nd.color) {
        ctx.fillStyle = nd.color;
      } else if (selectedNode === i) {
        ctx.fillStyle = '#a855f7';
      } else {
        ctx.fillStyle = '#6366f1';
      }
      ctx.fill();
      ctx.strokeStyle = '#fff'; ctx.lineWidth = 2.5; ctx.stroke();
      ctx.fillStyle = '#fff'; ctx.font = 'bold 12px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(String(i + 1), nd.x, nd.y);
    }
  }

  // BFS animation
  btnBFS.addEventListener('click', function() {
    if (animating || nodes.length === 0) return;
    animating = true; animOrder = []; animIdx = 0;
    var adj = getAdj();
    var visited = new Array(nodes.length).fill(false);
    var start = startNodeIndex();
    var queue = [start]; visited[start] = true;
    while (queue.length) {
      var n = queue.shift();
      animOrder.push(n);
      for (var j = 0; j < adj[n].length; j++) {
        if (!visited[adj[n][j]]) { visited[adj[n][j]] = true; queue.push(adj[n][j]); }
      }
    }
    animateTraversal('#22c55e');
  });

  // DFS animation
  btnDFS.addEventListener('click', function() {
    if (animating || nodes.length === 0) return;
    animating = true; animOrder = []; animIdx = 0;
    var adj = getAdj();
    var visited = new Array(nodes.length).fill(false);
    var stack = [startNodeIndex()];
    while (stack.length) {
      var n = stack.pop();
      if (visited[n]) continue;
      visited[n] = true;
      animOrder.push(n);
      for (var j = adj[n].length - 1; j >= 0; j--) {
        if (!visited[adj[n][j]]) stack.push(adj[n][j]);
      }
    }
    animateTraversal('#f59e0b');
  });

  function animateTraversal(color) {
    for (var i = 0; i < nodes.length; i++) nodes[i].color = null;
    function step() {
      if (animIdx >= animOrder.length) { animating = false; return; }
      nodes[animOrder[animIdx]].color = color;
      animIdx++;
      draw();
      setTimeout(step, traversalDelay);
    }
    step();
  }

  rebuildStartOptions();
  draw();
  updateStats();
})();

(function() {
  // ─── Demo 2: Random connected components ─────────────────────
  var svg = document.getElementById('cc-svg');
  if (!svg) return;
  var nRange = document.getElementById('cc-n');
  var densityRange = document.getElementById('cc-density');
  var nVal = document.getElementById('cc-n-val');
  var dVal = document.getElementById('cc-density-val');
  var btnGenerate = document.getElementById('cc-generate');
  var btnColor = document.getElementById('cc-color');
  var btnResetColors = document.getElementById('cc-reset-colors');
  var info = document.getElementById('cc-info');
  var nodes = [];
  var edges = [];
  var selected = -1;
  var palette = ['#38bdf8','#f97316','#22c55e','#eab308','#a855f7','#f43f5e','#14b8a6'];

  function setRangeLabels() {
    nVal.textContent = nRange.value;
    dVal.textContent = densityRange.value + '%';
  }

  function gen() {
    var n = parseInt(nRange.value, 10);
    var p = parseInt(densityRange.value, 10) / 100;
    var cx = 160, cy = 90, r = 68;
    nodes = [];
    edges = [];
    for (var i = 0; i < n; i++) {
      var a = (Math.PI * 2 * i) / n;
      nodes.push({ x: cx + r * Math.cos(a), y: cy + r * Math.sin(a), comp: -1 });
    }
    for (var i = 0; i < n; i++) {
      for (var j = i + 1; j < n; j++) {
        if (Math.random() < p) edges.push([i, j]);
      }
    }
    nodes.forEach(function(nd) { nd.comp = -1; });
    selected = -1;
    draw();
    info.textContent = 'Graf generat. Click pe 2 noduri pentru a adăuga/tăia muchie.';
  }

  function edgeIndex(u, v) {
    for (var i = 0; i < edges.length; i++) {
      var e = edges[i];
      if ((e[0] === u && e[1] === v) || (e[0] === v && e[1] === u)) return i;
    }
    return -1;
  }

  function findNode(x, y) {
    for (var i = 0; i < nodes.length; i++) {
      var dx = nodes[i].x - x;
      var dy = nodes[i].y - y;
      if (dx * dx + dy * dy <= 15 * 15) return i;
    }
    return -1;
  }

  function adjacency() {
    var adj = nodes.map(function() { return []; });
    edges.forEach(function(e) { adj[e[0]].push(e[1]); adj[e[1]].push(e[0]); });
    return adj;
  }

  function colorComponents() {
    if (!nodes.length) return;
    var adj = adjacency();
    var vis = new Array(nodes.length).fill(false);
    var comps = 0;
    var sizes = [];
    for (var i = 0; i < nodes.length; i++) {
      if (vis[i]) continue;
      comps++;
      var q = [i];
      vis[i] = true;
      var cnt = 0;
      while (q.length) {
        var u = q.shift();
        nodes[u].comp = comps - 1;
        cnt++;
        adj[u].forEach(function(v) {
          if (!vis[v]) { vis[v] = true; q.push(v); }
        });
      }
      sizes.push(cnt);
    }
    draw();
    info.textContent = 'Componente: ' + comps + ' · mărimi: [' + sizes.join(', ') + ']';
  }

  function draw() {
    var html = '';
    edges.forEach(function(e) {
      var a = nodes[e[0]], b = nodes[e[1]];
      html += '<line x1="' + a.x + '" y1="' + a.y + '" x2="' + b.x + '" y2="' + b.y + '" stroke="#64748b" stroke-width="2" opacity="0.6"/>';
    });
    nodes.forEach(function(nd, i) {
      var c = nd.comp >= 0 ? palette[nd.comp % palette.length] : '#6366f1';
      var stroke = selected === i ? '#f59e0b' : '#fff';
      var sw = selected === i ? 3 : 2;
      html += '<circle cx="' + nd.x + '" cy="' + nd.y + '" r="14" fill="' + c + '" stroke="' + stroke + '" stroke-width="' + sw + '"/>';
      html += '<text x="' + nd.x + '" y="' + (nd.y + 1) + '" text-anchor="middle" dominant-baseline="middle" fill="#fff" font-size="11" font-weight="700">' + (i+1) + '</text>';
    });
    svg.innerHTML = html;
  }

  svg.addEventListener('click', function(ev) {
    if (!nodes.length) return;
    var rect = svg.getBoundingClientRect();
    if (!rect.width || !rect.height) return;
    var x = (ev.clientX - rect.left) * (320 / rect.width);
    var y = (ev.clientY - rect.top) * (180 / rect.height);
    var hit = findNode(x, y);
    if (hit < 0) return;
    if (selected < 0) {
      selected = hit;
      info.textContent = 'Nod selectat: ' + (hit + 1) + '. Selectează al doilea nod.';
      draw();
      return;
    }
    if (selected !== hit) {
      var idx = edgeIndex(selected, hit);
      if (idx >= 0) {
        edges.splice(idx, 1);
        info.textContent = 'Muchia ' + (selected + 1) + '–' + (hit + 1) + ' a fost eliminată.';
      } else {
        edges.push([selected, hit]);
        info.textContent = 'Muchia ' + (selected + 1) + '–' + (hit + 1) + ' a fost adăugată.';
      }
      nodes.forEach(function(nd) { nd.comp = -1; });
    }
    selected = -1;
    draw();
  });

  nRange.addEventListener('input', setRangeLabels);
  densityRange.addEventListener('input', setRangeLabels);
  btnGenerate.addEventListener('click', gen);
  btnColor.addEventListener('click', colorComponents);
  btnResetColors.addEventListener('click', function() {
    nodes.forEach(function(nd) { nd.comp = -1; });
    selected = -1;
    draw();
    info.textContent = 'Culori resetate. Poți continua editarea muchiilor.';
  });

  setRangeLabels();
  gen();
})();

(function() {
  // ─── Demo 3: Interactive adjacency matrix ────────────────────
  var grid = document.getElementById('adj-grid');
  if (!grid) return;
  var svg = document.getElementById('adj-svg');
  var info = document.getElementById('adj-info');
  var btnRnd = document.getElementById('adj-random');
  var btnClr = document.getElementById('adj-clear');
  var N = 5;
  var a = Array.from({ length: N }, function() { return Array(N).fill(0); });
  var pos = [{x:160,y:24},{x:268,y:80},{x:225,y:165},{x:95,y:165},{x:52,y:80}];

  function isConnected() {
    var start = -1;
    for (var i = 0; i < N; i++) {
      var deg = a[i].reduce(function(s, x) { return s + x; }, 0);
      if (deg > 0) { start = i; break; }
    }
    if (start === -1) return false;
    var vis = Array(N).fill(false);
    var q = [start]; vis[start] = true;
    while (q.length) {
      var u = q.shift();
      for (var v = 0; v < N; v++) {
        if (a[u][v] && !vis[v]) { vis[v] = true; q.push(v); }
      }
    }
    for (var i = 0; i < N; i++) {
      var deg2 = a[i].reduce(function(s, x) { return s + x; }, 0);
      if (deg2 > 0 && !vis[i]) return false;
    }
    return true;
  }

  function recalcInfo() {
    var deg = [];
    var m = 0;
    for (var i = 0; i < N; i++) {
      var g = 0;
      for (var j = 0; j < N; j++) g += a[i][j];
      deg.push(g);
      m += g;
    }
    m = Math.floor(m / 2);
    info.textContent = 'Muchii: ' + m + ' · Grade: ' + deg.join(', ') + ' · Conex: ' + (isConnected() ? 'DA' : 'NU');
  }

  function renderGraph() {
    if (!svg) return;
    var html = '';
    for (var i = 0; i < N; i++) {
      for (var j = i + 1; j < N; j++) {
        if (a[i][j]) {
          html += '<line x1="' + pos[i].x + '" y1="' + pos[i].y + '" x2="' + pos[j].x + '" y2="' + pos[j].y + '" stroke="#0ea5e9" stroke-width="3" opacity="0.75"/>';
        }
      }
    }
    for (var k = 0; k < N; k++) {
      html += '<circle cx="' + pos[k].x + '" cy="' + pos[k].y + '" r="15" fill="#0284c7" stroke="#fff" stroke-width="2"/>';
      html += '<text x="' + pos[k].x + '" y="' + (pos[k].y + 1) + '" text-anchor="middle" dominant-baseline="middle" fill="#fff" font-size="11" font-weight="700">' + (k + 1) + '</text>';
    }
    svg.innerHTML = html;
  }

  function render() {
    var html = '';
    html += '<div></div>';
    for (var j = 0; j < N; j++) html += '<div style="font-size:11px;color:var(--text-muted);text-align:center;align-self:end;">' + (j+1) + '</div>';
    for (var i = 0; i < N; i++) {
      html += '<div style="font-size:11px;color:var(--text-muted);text-align:center;line-height:28px;">' + (i+1) + '</div>';
      for (var j = 0; j < N; j++) {
        var diag = i === j;
        var active = a[i][j] === 1;
        var style = 'height:28px;border-radius:6px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:11px;cursor:' + (diag ? 'not-allowed' : 'pointer') + ';';
        style += active ? 'background:rgba(14,165,233,.2);color:#0ea5e9;font-weight:700;' : 'background:var(--surface2);color:var(--text-muted);';
        html += '<button data-i="' + i + '" data-j="' + j + '" style="' + style + '" ' + (diag ? 'disabled' : '') + '>' + (diag ? '•' : (active ? '1' : '0')) + '</button>';
      }
    }
    grid.innerHTML = html;
    grid.querySelectorAll('button[data-i]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var i = parseInt(btn.getAttribute('data-i'), 10);
        var j = parseInt(btn.getAttribute('data-j'), 10);
        var next = a[i][j] ? 0 : 1;
        a[i][j] = next;
        a[j][i] = next;
        render();
      });
    });
    recalcInfo();
    renderGraph();
  }

  btnClr.addEventListener('click', function() {
    a = Array.from({ length: N }, function() { return Array(N).fill(0); });
    render();
  });
  btnRnd.addEventListener('click', function() {
    a = Array.from({ length: N }, function() { return Array(N).fill(0); });
    for (var i = 0; i < N; i++) {
      for (var j = i + 1; j < N; j++) {
        if (Math.random() < 0.35) {
          a[i][j] = 1;
          a[j][i] = 1;
        }
      }
    }
    render();
  });

  render();
})();

(function() {
  // ─── Demo 4: Directed graph matrix ───────────────────────────
  var grid = document.getElementById('digraph-grid');
  if (!grid) return;
  var svg = document.getElementById('digraph-svg');
  var info = document.getElementById('digraph-info');
  var btnRnd = document.getElementById('digraph-random');
  var btnClr = document.getElementById('digraph-clear');
  var N = 4;
  var a = Array.from({ length: N }, function() { return Array(N).fill(0); });
  var pos = [{x:160,y:24},{x:280,y:95},{x:160,y:165},{x:40,y:95}];

  function drawArrow(x1, y1, x2, y2, color) {
    var dx = x2 - x1;
    var dy = y2 - y1;
    var len = Math.sqrt(dx * dx + dy * dy) || 1;
    var ux = dx / len;
    var uy = dy / len;
    var sx = x1 + ux * 16;
    var sy = y1 + uy * 16;
    var ex = x2 - ux * 20;
    var ey = y2 - uy * 20;
    var lx = ex - ux * 8 - uy * 6;
    var ly = ey - uy * 8 + ux * 6;
    var rx = ex - ux * 8 + uy * 6;
    var ry = ey - uy * 8 - ux * 6;
    return '<line x1="' + sx + '" y1="' + sy + '" x2="' + ex + '" y2="' + ey + '" stroke="' + color + '" stroke-width="2.5" opacity="0.8"/>' +
      '<polygon points="' + ex + ',' + ey + ' ' + lx + ',' + ly + ' ' + rx + ',' + ry + '" fill="' + color + '" opacity="0.9"/>';
  }

  function renderGraph() {
    if (!svg) return;
    var html = '';
    for (var i = 0; i < N; i++) {
      for (var j = 0; j < N; j++) {
        if (i !== j && a[i][j]) {
          html += drawArrow(pos[i].x, pos[i].y, pos[j].x, pos[j].y, '#16a34a');
        }
      }
    }
    for (var k = 0; k < N; k++) {
      html += '<circle cx="' + pos[k].x + '" cy="' + pos[k].y + '" r="15" fill="#15803d" stroke="#fff" stroke-width="2"/>';
      html += '<text x="' + pos[k].x + '" y="' + (pos[k].y + 1) + '" text-anchor="middle" dominant-baseline="middle" fill="#fff" font-size="11" font-weight="700">' + (k + 1) + '</text>';
    }
    svg.innerHTML = html;
  }

  function render() {
    var html = '<div></div>';
    for (var j = 0; j < N; j++) html += '<div style="font-size:11px;color:var(--text-muted);text-align:center;align-self:end;">' + (j+1) + '</div>';
    for (var i = 0; i < N; i++) {
      html += '<div style="font-size:11px;color:var(--text-muted);text-align:center;line-height:28px;">' + (i+1) + '</div>';
      for (var j = 0; j < N; j++) {
        var diag = i === j;
        var active = a[i][j] === 1;
        var style = 'height:28px;border-radius:6px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:11px;cursor:' + (diag ? 'not-allowed' : 'pointer') + ';';
        style += active ? 'background:rgba(34,197,94,.18);color:#16a34a;font-weight:700;' : 'background:var(--surface2);color:var(--text-muted);';
        html += '<button data-i="' + i + '" data-j="' + j + '" style="' + style + '" ' + (diag ? 'disabled' : '') + '>' + (diag ? '•' : (active ? '1' : '0')) + '</button>';
      }
    }
    grid.innerHTML = html;
    grid.querySelectorAll('button[data-i]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var i = parseInt(btn.getAttribute('data-i'), 10);
        var j = parseInt(btn.getAttribute('data-j'), 10);
        a[i][j] = a[i][j] ? 0 : 1;
        render();
      });
    });
    recalc();
    renderGraph();
  }

  function recalc() {
    var outDeg = [], inDeg = [], m = 0;
    for (var i = 0; i < N; i++) {
      var o = 0, inn = 0;
      for (var j = 0; j < N; j++) {
        o += a[i][j];
        inn += a[j][i];
      }
      outDeg.push(o); inDeg.push(inn); m += o;
    }
    info.textContent = 'Arce: ' + m + ' · d⁺: ' + outDeg.join(', ') + ' · d⁻: ' + inDeg.join(', ') + ' · max = ' + (N * (N - 1));
  }

  btnClr.addEventListener('click', function() {
    a = Array.from({ length: N }, function() { return Array(N).fill(0); });
    render();
  });
  btnRnd.addEventListener('click', function() {
    a = Array.from({ length: N }, function() { return Array(N).fill(0); });
    for (var i = 0; i < N; i++) {
      for (var j = 0; j < N; j++) {
        if (i !== j && Math.random() < 0.3) a[i][j] = 1;
      }
    }
    render();
  });

  render();
})();

(function() {
  // ─── Demo SCC: Strongly connected components ────────────────
  var svg = document.getElementById('scc-svg');
  if (!svg) return;
  var info = document.getElementById('scc-info');
  var btnA = document.getElementById('scc-preset-a');
  var btnB = document.getElementById('scc-preset-b');
  var btnRun = document.getElementById('scc-run');
  var nodes = [
    { x: 45, y: 45 }, { x: 130, y: 36 }, { x: 235, y: 45 },
    { x: 58, y: 130 }, { x: 158, y: 110 }, { x: 258, y: 134 }
  ];
  var edges = [];
  var comp = [];
  var colors = ['#38bdf8','#f97316','#22c55e','#a855f7','#f43f5e','#14b8a6'];

  function arrow(x1, y1, x2, y2, color, op) {
    var dx = x2 - x1, dy = y2 - y1;
    var len = Math.sqrt(dx * dx + dy * dy) || 1;
    var ux = dx / len, uy = dy / len;
    var sx = x1 + ux * 17, sy = y1 + uy * 17;
    var ex = x2 - ux * 17, ey = y2 - uy * 17;
    var hx = ex - ux * 8, hy = ey - uy * 8;
    var px = -uy, py = ux;
    var p1x = hx + px * 4, p1y = hy + py * 4;
    var p2x = hx - px * 4, p2y = hy - py * 4;
    return '<line x1="' + sx + '" y1="' + sy + '" x2="' + ex + '" y2="' + ey + '" stroke="' + color + '" stroke-width="2.3" opacity="' + op + '"/>' +
      '<polygon points="' + ex + ',' + ey + ' ' + p1x + ',' + p1y + ' ' + p2x + ',' + p2y + '" fill="' + color + '" opacity="' + op + '"/>';
  }

  function setPreset(name) {
    if (name === 'A') {
      edges = [
        [0,1],[1,0],[1,2],[2,4],[4,2],[4,5],[5,4],[3,0],[0,3],[1,4],[3,4]
      ];
    } else {
      edges = [
        [0,1],[1,2],[2,0],[2,3],[3,4],[4,5],[5,3],[1,4]
      ];
    }
    comp = new Array(nodes.length).fill(-1);
    draw();
    info.textContent = 'Preset ' + name + ' încărcat. Apasă „Arată SCC”.';
  }

  function kosaraju() {
    var n = nodes.length;
    var g = Array.from({ length: n }, function() { return []; });
    var gt = Array.from({ length: n }, function() { return []; });
    edges.forEach(function(e) {
      g[e[0]].push(e[1]);
      gt[e[1]].push(e[0]);
    });

    var vis = new Array(n).fill(false);
    var order = [];
    function dfs1(u) {
      vis[u] = true;
      for (var i = 0; i < g[u].length; i++) {
        var v = g[u][i];
        if (!vis[v]) dfs1(v);
      }
      order.push(u);
    }
    for (var i = 0; i < n; i++) if (!vis[i]) dfs1(i);

    var id = 0;
    comp = new Array(n).fill(-1);
    function dfs2(u, c) {
      comp[u] = c;
      for (var i = 0; i < gt[u].length; i++) {
        var v = gt[u][i];
        if (comp[v] === -1) dfs2(v, c);
      }
    }
    for (var k = order.length - 1; k >= 0; k--) {
      var u = order[k];
      if (comp[u] === -1) {
        dfs2(u, id);
        id++;
      }
    }

    draw();
    var sizes = [];
    for (var c = 0; c < id; c++) {
      sizes.push(comp.filter(function(x) { return x === c; }).length);
    }
    info.textContent = 'Componente tare conexe: ' + id + ' · mărimi: [' + sizes.join(', ') + ']';
  }

  function draw() {
    var html = '';
    for (var i = 0; i < edges.length; i++) {
      var e = edges[i];
      var col = (comp[e[0]] >= 0 && comp[e[0]] === comp[e[1]]) ? colors[comp[e[0]] % colors.length] : '#64748b';
      html += arrow(nodes[e[0]].x, nodes[e[0]].y, nodes[e[1]].x, nodes[e[1]].y, col, 0.75);
    }
    for (var j = 0; j < nodes.length; j++) {
      var nd = nodes[j];
      var fill = comp[j] >= 0 ? colors[comp[j] % colors.length] : '#475569';
      html += '<circle cx="' + nd.x + '" cy="' + nd.y + '" r="15" fill="' + fill + '" stroke="#fff" stroke-width="2"/>';
      html += '<text x="' + nd.x + '" y="' + (nd.y + 1) + '" text-anchor="middle" dominant-baseline="middle" fill="#fff" font-size="11" font-weight="700">' + (j + 1) + '</text>';
    }
    svg.innerHTML = html;
  }

  btnA.addEventListener('click', function() { setPreset('A'); });
  btnB.addEventListener('click', function() { setPreset('B'); });
  btnRun.addEventListener('click', kosaraju);

  setPreset('A');
})();

