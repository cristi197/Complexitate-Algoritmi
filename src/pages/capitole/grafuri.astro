    {x:160,y:28},{x:90,y:82},{x:230,y:82},{x:60,y:150},{x:120,y:150},{x:220,y:150}
  ];
  var edges = [];

  function setPreset(type) {
    if (type === 'tree') edges = [[0,1],[0,2],[1,3],[1,4],[2,5]];
    else if (type === 'cycle') edges = [[0,1],[0,2],[1,3],[1,4],[2,5],[4,5]];
    else edges = [[0,1],[1,3],[2,5]];
    draw();
    updateInfo();
  }

  function connectedAndCycle() {
    var adj = nodes.map(function(){ return []; });
    edges.forEach(function(e){ adj[e[0]].push(e[1]); adj[e[1]].push(e[0]); });
    var vis = Array(nodes.length).fill(false);
    var hasCycle = false;
    function dfs(u, p) {
      vis[u] = true;
      adj[u].forEach(function(v){
        if (!vis[v]) dfs(v, u);
        else if (v !== p) hasCycle = true;
      });
    }
    dfs(0, -1);
    var connected = vis.every(Boolean);
    return { connected: connected, cycle: hasCycle };
  }

  function updateInfo() {
    var state = connectedAndCycle();
    var n = nodes.length, m = edges.length;
    var isTree = state.connected && !state.cycle && m === n - 1;
    info.innerHTML = 'n = ' + n + ' · m = ' + m + ' · conex: <strong>' + (state.connected ? 'DA' : 'NU') + '</strong> · ciclu: <strong>' + (state.cycle ? 'DA' : 'NU') + '</strong> · arbore: <strong>' + (isTree ? 'DA' : 'NU') + '</strong>';
  }

  function draw() {
    var html = '';
    edges.forEach(function(e) {
      var a = nodes[e[0]], b = nodes[e[1]];
      html += '<line x1="' + a.x + '" y1="' + a.y + '" x2="' + b.x + '" y2="' + b.y + '" stroke="#8b5cf6" stroke-width="3" opacity="0.8"/>';
    });
    nodes.forEach(function(nd, i) {
      html += '<circle cx="' + nd.x + '" cy="' + nd.y + '" r="15" fill="#6366f1" stroke="#fff" stroke-width="2"/>';
      html += '<text x="' + nd.x + '" y="' + (nd.y+1) + '" text-anchor="middle" dominant-baseline="middle" fill="#fff" font-size="11" font-weight="700">' + (i+1) + '</text>';
    });
    svg.innerHTML = html;
  }

  btnTree.addEventListener('click', function(){ setPreset('tree'); });
  btnCycle.addEventListener('click', function(){ setPreset('cycle'); });
  btnDisc.addEventListener('click', function(){ setPreset('disconnected'); });
  setPreset('tree');
})();

(function() {
  // ─── Demo 6: Edge formulas calculator ───────────────────────
  var range = document.getElementById('edgecalc-n');
  if (!range) return;
  var typeSel = document.getElementById('edgecalc-type');
  var nVal = document.getElementById('edgecalc-n-val');
  var cards = document.getElementById('edgecalc-cards');
  var bars = document.getElementById('edgecalc-bars');
  var formula = document.getElementById('edgecalc-formula');

  function card(title, value, accent) {
    return '<div style="padding:10px;border-radius:10px;border:1px solid var(--border);background:var(--surface2);">' +
      '<div style="font-size:11px;color:var(--text-muted);margin-bottom:4px;">' + title + '</div>' +
      '<div style="font-size:22px;font-weight:800;color:' + accent + ';">' + value + '</div>' +
      '</div>';
  }

  function render() {
    var n = parseInt(range.value, 10);
    var type = typeSel.value;
    var minEdges = 0, maxEdges = 0, text = '';
    var hardMax = n * (n - 1);
    if (type === 'simple') {
      minEdges = 0;
      maxEdges = n * (n - 1) / 2;
      text = 'Graf simplu neorientat: m ∈ [0, n(n−1)/2].';
    } else if (type === 'connected') {
      minEdges = Math.max(0, n - 1);
      maxEdges = n * (n - 1) / 2;
      text = 'Graf simplu conex: minim n−1 muchii, maxim Kₙ = n(n−1)/2.';
    } else {
      minEdges = 0;
      maxEdges = n * (n - 1);
      text = 'Graf orientat simplu: m ∈ [0, n(n−1)] deoarece fiecare arc are sens.';
    }
    nVal.textContent = String(n);
    cards.innerHTML = card('Muchii minime', minEdges, '#16a34a') + card('Muchii maxime', maxEdges, '#2563eb');
    var minPct = hardMax === 0 ? 0 : Math.round((minEdges / hardMax) * 100);
    var maxPct = hardMax === 0 ? 0 : Math.round((maxEdges / hardMax) * 100);
    bars.innerHTML =
      '<div style="font-size:11px;color:var(--text-muted);">Scară vizuală din maximul orientat n(n−1) = ' + hardMax + '</div>' +
      '<div style="font-size:11px;color:var(--text-muted);">Minim</div>' +
      '<div style="height:11px;border-radius:999px;background:rgba(148,163,184,.22);overflow:hidden;">' +
      '<div style="height:100%;width:' + minPct + '%;background:linear-gradient(90deg,#16a34a,#22c55e);"></div></div>' +
      '<div style="font-size:11px;color:var(--text-muted);">Maxim</div>' +
      '<div style="height:11px;border-radius:999px;background:rgba(148,163,184,.22);overflow:hidden;">' +
      '<div style="height:100%;width:' + maxPct + '%;background:linear-gradient(90deg,#2563eb,#38bdf8);"></div></div>';
    formula.textContent = text;
  }

  range.addEventListener('input', render);
  typeSel.addEventListener('change', render);
  render();
})();

(function() {
  // ─── Demo 7: Eulerian / Hamiltonian explorer ────────────────
  var svg = document.getElementById('eh-svg');
  if (!svg) return;
  var badgeWrap = document.getElementById('eh-badges');
  var info = document.getElementById('eh-info');
  var nodes = [];
  var edges = [];

  function setPreset(name) {
    if (name === 'cycle5') {
      nodes = [{x:160,y:25},{x:265,y:78},{x:225,y:160},{x:95,y:160},{x:55,y:78}];
      edges = [[0,1],[1,2],[2,3],[3,4],[4,0]];
      info.textContent = 'Ciclul C₅: toate gradele sunt 2, deci este eulerian și hamiltonian.';
    } else if (name === 'path5') {
      nodes = [{x:35,y:95},{x:100,y:95},{x:165,y:95},{x:230,y:95},{x:295,y:95}];
      edges = [[0,1],[1,2],[2,3],[3,4]];
      info.textContent = 'Lanțul P₅ are exact 2 noduri de grad impar: are lanț eulerian, dar nu ciclu eulerian și nici ciclu hamiltonian.';
    } else if (name === 'k5') {
      nodes = [{x:160,y:22},{x:270,y:80},{x:230,y:165},{x:90,y:165},{x:50,y:80}];
      edges = [[0,1],[0,2],[0,3],[0,4],[1,2],[1,3],[1,4],[2,3],[2,4],[3,4]];
      info.textContent = 'K₅ are grad 4 în fiecare nod: este eulerian și are ciclu hamiltonian.';
    } else {
      nodes = [{x:160,y:30},{x:80,y:95},{x:240,y:95},{x:45,y:165},{x:115,y:165}];
      edges = [[0,1],[0,2],[0,3],[0,4]];
      info.textContent = 'Steaua S₅ nu este euleriană și nici hamiltoniană: are multe frunze și nu poate forma ciclu prin toate nodurile.';
    }
    draw();
    updateBadges();
  }

  function adjacency() {
    var adj = nodes.map(function(){ return []; });
    edges.forEach(function(e){ adj[e[0]].push(e[1]); adj[e[1]].push(e[0]); });
    return adj;
  }

  function connectedIgnoringIsolated() {
    var adj = adjacency();
    var start = adj.findIndex(function(v){ return v.length > 0; });
    if (start === -1) return false;
    var vis = Array(nodes.length).fill(false);
    var st = [start];
    while (st.length) {
      var u = st.pop();
      if (vis[u]) continue;
      vis[u] = true;
      adj[u].forEach(function(v){ if (!vis[v]) st.push(v); });
    }
    return adj.every(function(v, i){ return v.length === 0 || vis[i]; });
  }

  function hasHamiltonianCycle() {
    var n = nodes.length;
    if (n < 3) return false;
    var adj = adjacency();
    function dfs(path, used) {
      if (path.length === n) return adj[path[path.length - 1]].includes(path[0]);
      var last = path[path.length - 1];
      for (var i = 0; i < adj[last].length; i++) {
        var nxt = adj[last][i];
        if (!used[nxt]) {
          used[nxt] = true;
          path.push(nxt);
          if (dfs(path, used)) return true;
          path.pop();
          used[nxt] = false;
        }
      }
      return false;
    }
    var used = Array(n).fill(false);
    used[0] = true;
    return dfs([0], used);
  }

  function properties() {
    var adj = adjacency();
    var odd = adj.filter(function(v){ return v.length % 2 === 1; }).length;
    var connected = connectedIgnoringIsolated();
    return {
      eulerian: connected && odd === 0 && adj.every(function(v){ return v.length > 0; }),
      eulerTrail: connected && odd === 2,
      hamiltonian: hasHamiltonianCycle()
    };
  }

  function badge(text, ok, color) {
    return '<span style="padding:6px 10px;border-radius:999px;font-size:12px;font-weight:700;background:' + (ok ? color : 'rgba(148,163,184,.14)') + ';color:' + (ok ? '#fff' : 'var(--text-muted)') + ';">' + text + ': ' + (ok ? 'DA' : 'NU') + '</span>';
  }

  function updateBadges() {
    var p = properties();
    badgeWrap.innerHTML = badge('Ciclu eulerian', p.eulerian, '#16a34a') + badge('Lanț eulerian', p.eulerTrail, '#f59e0b') + badge('Ciclu hamiltonian', p.hamiltonian, '#8b5cf6');
  }

  function draw() {
    var html = '';
    edges.forEach(function(e) {
      var a = nodes[e[0]], b = nodes[e[1]];
      html += '<line x1="' + a.x + '" y1="' + a.y + '" x2="' + b.x + '" y2="' + b.y + '" stroke="#6366f1" stroke-width="3" opacity="0.75"/>';
    });
    nodes.forEach(function(nd, i) {
      html += '<circle cx="' + nd.x + '" cy="' + nd.y + '" r="15" fill="#8b5cf6" stroke="#fff" stroke-width="2"/>';
      html += '<text x="' + nd.x + '" y="' + (nd.y+1) + '" text-anchor="middle" dominant-baseline="middle" fill="#fff" font-size="11" font-weight="700">' + (i+1) + '</text>';
    });
    svg.innerHTML = html;
  }

  document.querySelectorAll('[data-eh]').forEach(function(btn) {
    btn.addEventListener('click', function() { setPreset(btn.getAttribute('data-eh')); });
  });

  setPreset('cycle5');
})();

(function() {
  // ─── Demo 8: Euler / Hamilton traversal walkthrough ─────────
  var svg = document.getElementById('walk-svg');
  if (!svg) return;
  var info = document.getElementById('walk-info');
  var legend = document.getElementById('walk-legend');
  var btnEuler = document.getElementById('walk-run-euler');
  var btnHamilton = document.getElementById('walk-run-hamilton');
  var nodes = [];
  var edges = [];
  var timer = null;
  var stepIndex = 0;
  var path = [];
  var mode = '';

  function setPreset(name) {
    if (timer) { clearInterval(timer); timer = null; }
    if (name === 'cycle5') {
      nodes = [{x:160,y:25},{x:265,y:78},{x:225,y:160},{x:95,y:160},{x:55,y:78}];
      edges = [[0,1],[1,2],[2,3],[3,4],[4,0]];
    } else if (name === 'path5') {
      nodes = [{x:35,y:95},{x:100,y:95},{x:165,y:95},{x:230,y:95},{x:295,y:95}];
      edges = [[0,1],[1,2],[2,3],[3,4]];
    } else if (name === 'k5') {
      nodes = [{x:160,y:22},{x:270,y:80},{x:230,y:165},{x:90,y:165},{x:50,y:80}];
      edges = [[0,1],[0,2],[0,3],[0,4],[1,2],[1,3],[1,4],[2,3],[2,4],[3,4]];
    } else {
      nodes = [{x:160,y:30},{x:80,y:95},{x:240,y:95},{x:45,y:165},{x:115,y:165}];
      edges = [[0,1],[0,2],[0,3],[0,4]];
    }
    stepIndex = 0;
    path = [];
    mode = '';
    legend.innerHTML = '';
    info.textContent = 'Preset încărcat. Rulează Euler sau Hamilton.';
    draw();
  }

  function adjacencyWithEdgeIndex() {
    var adj = Array.from({ length: nodes.length }, function() { return []; });
    edges.forEach(function(e, idx) {
      adj[e[0]].push({ v: e[1], id: idx });
      adj[e[1]].push({ v: e[0], id: idx });
    });
    return adj;
  }

  function connectedIgnoringIsolated(adj, deg) {
    var start = -1;
    for (var i = 0; i < deg.length; i++) {
      if (deg[i] > 0) { start = i; break; }
    }
    if (start < 0) return false;
    var vis = Array(nodes.length).fill(false);
    var st = [start];
    while (st.length) {
      var u = st.pop();
      if (vis[u]) continue;
      vis[u] = true;
      adj[u].forEach(function(x) { if (!vis[x.v]) st.push(x.v); });
    }
    for (var j = 0; j < deg.length; j++) {
      if (deg[j] > 0 && !vis[j]) return false;
    }
    return true;
  }

  function findEulerWalk() {
    var adj = adjacencyWithEdgeIndex();
    var deg = adj.map(function(v) { return v.length; });
    var odd = [];
    for (var i = 0; i < deg.length; i++) {
      if (deg[i] % 2 === 1) odd.push(i);
    }
    if (!(odd.length === 0 || odd.length === 2)) return null;
    if (!connectedIgnoringIsolated(adj, deg)) return null;

    var used = Array(edges.length).fill(false);
    var stack = [];
    var out = [];
    var start = odd.length === 2 ? odd[0] : deg.findIndex(function(x) { return x > 0; });
    if (start < 0) return null;
    stack.push(start);

    while (stack.length) {
      var u = stack[stack.length - 1];
      var nextEdge = null;
      for (var k = 0; k < adj[u].length; k++) {
        if (!used[adj[u][k].id]) {
          nextEdge = adj[u][k];
          break;
        }
      }
      if (!nextEdge) {
        out.push(u);
        stack.pop();
      } else {
        used[nextEdge.id] = true;
        stack.push(nextEdge.v);
      }
    }
    out.reverse();
    if (out.length !== edges.length + 1) return null;
    return out;
  }

  function hasEdge(u, v) {
    for (var i = 0; i < edges.length; i++) {
      if ((edges[i][0] === u && edges[i][1] === v) || (edges[i][0] === v && edges[i][1] === u)) return true;
    }
    return false;
  }

  function findHamiltonCycle() {
    var n = nodes.length;
    if (n < 3) return null;
    var used = Array(n).fill(false);
    var seq = [0];
    used[0] = true;

    function bt() {
      if (seq.length === n) {
        if (hasEdge(seq[seq.length - 1], seq[0])) {
          seq.push(seq[0]);
          return true;
        }
        return false;
      }
      var last = seq[seq.length - 1];
      for (var v = 0; v < n; v++) {
        if (!used[v] && hasEdge(last, v)) {
          used[v] = true;
          seq.push(v);
          if (bt()) return true;
          seq.pop();
          used[v] = false;
        }
      }
      return false;
    }

    return bt() ? seq.slice() : null;
  }

  function edgeInPrefix(u, v, upto) {
    for (var i = 0; i < upto; i++) {
      if ((path[i] === u && path[i + 1] === v) || (path[i] === v && path[i + 1] === u)) return true;
    }
    return false;
  }

  function draw() {
    var html = '';
    edges.forEach(function(e) {
      var walked = path.length > 1 && edgeInPrefix(e[0], e[1], stepIndex);
      html += '<line x1="' + nodes[e[0]].x + '" y1="' + nodes[e[0]].y + '" x2="' + nodes[e[1]].x + '" y2="' + nodes[e[1]].y + '" stroke="' + (walked ? '#f97316' : '#64748b') + '" stroke-width="' + (walked ? 4 : 2.5) + '" opacity="0.85"/>';
    });
    nodes.forEach(function(nd, i) {
      var visited = false;
      var current = false;
      for (var j = 0; j <= stepIndex; j++) {
        if (path[j] === i) visited = true;
      }
      if (path.length > 0 && path[Math.min(stepIndex, path.length - 1)] === i) current = true;
      var fill = current ? '#f97316' : (visited ? '#22c55e' : '#6366f1');
      html += '<circle cx="' + nd.x + '" cy="' + nd.y + '" r="15" fill="' + fill + '" stroke="#fff" stroke-width="2"/>';
      html += '<text x="' + nd.x + '" y="' + (nd.y + 1) + '" text-anchor="middle" dominant-baseline="middle" fill="#fff" font-size="11" font-weight="700">' + (i + 1) + '</text>';
    });
    svg.innerHTML = html;
  }

  function runAnimation(label, foundPath) {
    if (!foundPath || foundPath.length < 2) {
      info.textContent = 'Nu există ' + label + ' pentru presetul curent.';
      return;
    }
    if (timer) clearInterval(timer);
    mode = label;
    path = foundPath;
    stepIndex = 0;
    legend.innerHTML =
      '<span style="padding:4px 8px;border-radius:999px;background:rgba(34,197,94,.18);color:#166534;font-size:11px;font-weight:700;">Nod vizitat</span>' +
      '<span style="padding:4px 8px;border-radius:999px;background:rgba(249,115,22,.18);color:#9a3412;font-size:11px;font-weight:700;">Muchie/nod curent</span>';
    draw();

    timer = setInterval(function() {
      stepIndex++;
      if (stepIndex >= path.length - 1) {
        stepIndex = path.length - 1;
        draw();
        clearInterval(timer);
        timer = null;
        info.textContent = mode + ' finalizat: ' + path.map(function(v) { return v + 1; }).join(' → ');
        return;
      }
      draw();
      info.textContent = mode + ' · pas ' + (stepIndex + 1) + '/' + (path.length - 1) + ' · nod curent: ' + (path[stepIndex] + 1);
    }, 700);
  }

  btnEuler.addEventListener('click', function() {
    runAnimation('Traseu eulerian', findEulerWalk());
  });
  btnHamilton.addEventListener('click', function() {
    runAnimation('Ciclu hamiltonian', findHamiltonCycle());
  });

  document.querySelectorAll('[data-walk]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      setPreset(btn.getAttribute('data-walk'));
    });
  });

  setPreset('cycle5');
})();
</script>

