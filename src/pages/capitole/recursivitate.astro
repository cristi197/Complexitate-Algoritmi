<script is:inline>
(function() {
  function byId(id) { return document.getElementById(id); }
  if (!byId('rec-d2-run')) return;
  var runId = 0;
  var paused = false;
  var currentOut = null;

  function stepDelay() {
    var s = parseInt((byId('rec-step-speed') && byId('rec-step-speed').value) || '4', 10);
    return 1400 - s * 110;
  }

  async function sleepStep(ms, id) {
    var left = ms;
    while (left > 0) {
      if (id !== runId) return false;
      if (paused) {
        await new Promise(function(r) { setTimeout(r, 60); });
        continue;
      }
      var part = Math.min(60, left);
      await new Promise(function(r) { setTimeout(r, part); });
      left -= part;
    }
    return id === runId;
  }

  function setStatus(txt) {
    var s = byId('rec-step-status');
    if (s) s.textContent = txt;
  }

  function clearOut(out) {
    if (out) out.innerHTML = '';
  }

  function append(out, txt) {
    var row = document.createElement('div');
    row.textContent = txt;
    row.style.padding = '3px 0';
    row.style.borderBottom = '1px dashed rgba(255,255,255,.08)';
    out.appendChild(row);
  }

  async function play(out, steps) {
    currentOut = out;
    clearOut(out);
    var id = ++runId;
    setStatus('Rulează pas cu pas...');
    for (var i = 0; i < steps.length; i++) {
      if (id !== runId) return;
      append(out, steps[i]);
      var ok = await sleepStep(stepDelay(), id);
      if (!ok) return;
    }
    setStatus('Finalizat');
  }

  byId('rec-step-pause').addEventListener('click', function() {
    paused = !paused;
    byId('rec-step-pause').textContent = paused ? '▶ Continuă' : '⏸ Pauză';
    setStatus(paused ? 'Pauză' : 'Rulează pas cu pas...');
  });

  byId('rec-step-reset').addEventListener('click', function() {
    runId++;
    paused = false;
    byId('rec-step-pause').textContent = '⏸ Pauză';
    setStatus('Reset');
    if (currentOut) currentOut.innerHTML = 'Demo resetat.';
  });

  byId('rec-d2-run').addEventListener('click', async function() {
    var n = parseInt(byId('rec-d2-n').value || '0', 10);
    if (!Number.isFinite(n) || n < 0 || n > 35) {
      byId('rec-d2-out').textContent = 'Alege n intre 0 si 35.';
      return;
    }
    var callsSlow = 0;
    function fibSlow(x) {
      callsSlow++;
      if (x <= 1) return x;
      return fibSlow(x - 1) + fibSlow(x - 2);
    }
    var callsMemo = 0;
    var memo = {};
    function fibMemo(x) {
      callsMemo++;
      if (x <= 1) return x;
      if (memo[x] !== undefined) return memo[x];
      memo[x] = fibMemo(x - 1) + fibMemo(x - 2);
      return memo[x];
    }
    var a = fibSlow(n);
    fibMemo(n);
    var steps = [
      '1) Calculăm fib(' + n + ') prin recursie simplă.',
      '2) Rezultat: ' + a,
      '3) Număr apeluri fără memoizare: ' + callsSlow,
      '4) Repetăm cu memoizare (cache pentru subprobleme).',
      '5) Număr apeluri cu memoizare: ' + callsMemo,
      'Concluzie: memoizarea reduce dramatic recalculările.'
    ];
    await play(byId('rec-d2-out'), steps);
  });

  byId('rec-d3-run').addEventListener('click', async function() {
    var a = Math.abs(parseInt(byId('rec-d3-a').value || '0', 10));
    var b = Math.abs(parseInt(byId('rec-d3-b').value || '0', 10));
    var steps = [];
    function gcd(x, y) {
      steps.push('cmmdc(' + x + ', ' + y + ')');
      if (y === 0) return x;
      steps.push(' -> b != 0, apelăm cmmdc(' + y + ', ' + (x % y) + ')');
      return gcd(y, x % y);
    }
    var g = gcd(a, b);
    steps.push('Caz de bază atins (b=0), rezultat = ' + g);
    await play(byId('rec-d3-out'), steps);
  });

  byId('rec-d4-run').addEventListener('click', async function() {
    var arr = (byId('rec-d4-arr').value || '')
      .trim()
      .split(/\s+/)
      .map(function(x) { return parseInt(x, 10); })
      .filter(function(x) { return Number.isFinite(x); });
    var x = parseInt(byId('rec-d4-x').value || '0', 10);
    if (!arr.length) {
      byId('rec-d4-out').textContent = 'Vector invalid.';
      return;
    }
    var steps = [];
    function bs(st, dr) {
      steps.push('Interval curent: [' + st + ', ' + dr + ']');
      if (st > dr) return -1;
      var mid = Math.floor((st + dr) / 2);
      steps.push('mij=' + mid + ', v[mij]=' + arr[mid]);
      if (arr[mid] === x) return mid;
      if (arr[mid] < x) {
        steps.push('v[mij] < x, mergem în jumătatea dreaptă');
        return bs(mid + 1, dr);
      }
      steps.push('v[mij] > x, mergem în jumătatea stângă');
      return bs(st, mid - 1);
    }
    var pos = bs(0, arr.length - 1);
    steps.push('Poziție finală: ' + pos);
    await play(byId('rec-d4-out'), steps);
  });

  byId('rec-d5-run').addEventListener('click', async function() {
    var n = Math.abs(parseInt(byId('rec-d5-n').value || '0', 10));
    var steps = [];
    function sumDigits(x) {
      steps.push('sumCifre(' + x + ')');
      if (x === 0) {
        steps.push('caz de bază: sumCifre(0)=0');
        return 0;
      }
      var c = x % 10;
      var rest = Math.floor(x / 10);
      steps.push('descompunere: ' + x + ' = ' + rest + ' * 10 + ' + c);
      return c + sumDigits(rest);
    }
    var s = sumDigits(n);
    steps.push('Suma cifrelor = ' + s);
    await play(byId('rec-d5-out'), steps);
  });
})();
</script>

